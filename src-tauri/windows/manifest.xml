<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Disruptor Proxy runs elevated, start to finish. Creating the WinTUN adapter and
       rewriting the system route table both require administrator rights, so the core
       has to run elevated no matter what; the only question is how it gets there.
       Elevating the app itself (one UAC prompt at launch) rather than the core on demand
       is what lets `platform/windows.rs` spawn the core as an ordinary child process.
       The alternative - which this replaced - was a "runas" ShellExecuteExW launch of a
       PowerShell wrapper dropped into app data, because "runas" cannot redirect a child's
       stdio. That shape (unsigned exe in %LOCALAPPDATA% -> writes a .ps1 -> runs it
       elevated with -ExecutionPolicy Bypass -WindowStyle Hidden -> spawns a hidden
       binary) is indistinguishable from a dropper to a behavioural classifier, and
       Defender's ML flagged release builds as Trojan:Win32/Bearfoos.B!ml for it. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
