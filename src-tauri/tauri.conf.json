{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "The Disruptor Proxy",
    "identifier": "io.disruptorproxy.client",
    "build":
    {
        "frontendDist": "../dist",
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build"
    },
    "app":
    {
        "windows":
        [
            {
                "title": "The Disruptor Proxy",
                "width": 400,
                "height": 720,
                "center": true,
                "resizable": false,
                "maximizable": false,
                "fullscreen": false,
                "decorations": false
            }
        ],
        "security":
        {
            "csp": null,
            "capabilities":
            [
                {
                    "identifier": "main-capability",
                    "windows":
                    [
                        "main"
                    ],
                    "permissions":
                    [
                        "core:app:allow-default-window-icon",

                        "core:window:allow-start-dragging",
                        "core:window:allow-minimize",
                        "core:window:allow-close",
                        "core:window:allow-hide",
                        "core:window:allow-show",

                        "core:window:allow-set-size",
                        "core:window:allow-set-min-size",
                        "core:window:allow-set-max-size",
                        "core:window:allow-set-resizable",
                        "core:window:allow-center",

                        "core:window:allow-unminimize",
                        "core:window:allow-set-focus",
                        "core:tray:default",
                        "core:menu:default",
                        "updater:default",
                        "process:allow-restart"
                    ]
                }
            ]
        }
    },
    "bundle":
    {
        "active": true,
        "targets": "all",
        "resources":
        [
            "assets/*"
        ],
        "icon":
        [
            "icons/icon.png",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true
    },
    "plugins":
    {
        "updater":
        {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBODNCOEZGMUQ0RkNERkUKUldUK3pVOGQvN2lEYW9vV1lFN1N0aFM2N2tQZ1ZCM1FJYmdnVW5USmgxY2dkREwzenJZSml0OXkK",
            "endpoints":
            [
                "https://github.com/DisruptorProxy/Xray-Client/releases/latest/download/latest.json"
            ]
        }
    }
}
