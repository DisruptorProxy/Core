# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

.playwright-mcp
.mimocode

node_modules
dist
dist-ssr
*.local
.env

# Updater signing keypair - the private half must NEVER be committed. It lives
# only on this machine and as the TAURI_SIGNING_PRIVATE_KEY repo secret.
src-tauri/.updater-key.pem
src-tauri/.updater-key.pem.pub

# The non-Windows Xray core is fetched per-host by scripts/fetch-core.mjs (verified
# against its .dgst), not committed. The Windows core (app-xray.exe + wintun.dll) stays
# committed for now.
src-tauri/assets/app-xray
# The Android core is fetched per-ABI into the gradle jniLibs, likewise not committed.
src-tauri/gen/android/app/src/main/jniLibs/*/libxray.so
# tun2socks, built from source by scripts/build-tun2socks.mjs (no prebuilt exists).
src-tauri/gen/android/app/src/main/jniLibs/*/libhev-socks5-tunnel.so

# Android release signing. The keystore and its passwords must never be committed - CI
# supplies them from secrets instead.
src-tauri/gen/android/app/keystore.properties
*.jks
*.keystore

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.claude
