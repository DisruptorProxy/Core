import { ErrorBoundary, Routes, Show } from 'azerothjs';

import { useLocale } from '../stores/locale';
import { usePlatform } from '../stores/platform';
import { useSubscriptions } from '../stores/subscriptions';
import { useTheme } from '../stores/theme';

import Button from '../components/button.component.azeroth';
import ToastHost from '../components/toast-host.component.azeroth';

import { router } from './router';
import SideRail from './side-rail.component.azeroth';
import TabBar from './tab-bar.component.azeroth';
import Titlebar from './titlebar.component.azeroth';
import { installTray } from './tray';

/**
 * App shell: a rail on wide screens, a bottom bar on phones, and the routed
 * screen in between. The theme and locale stores are instantiated here so the
 * document's `dir`, `lang` and theme class are owned from mount; the subscriptions
 * store is instantiated so its auto-update scheduler runs app-wide, not only while
 * the Subscriptions screen is open.
 */
export default component Shell()
{
    useTheme();
    const { t } = useLocale();
    const platform = usePlatform();
    useSubscriptions();

    // Window chrome is a desktop-only concept: mobile has no titlebar, tray, or
    // resizable window, and calling those Tauri APIs there would fail. The tray install
    // and the window-mode store (pulled in only by the gated Titlebar) never run on
    // mobile as a result.
    if (platform.isDesktop())
    {
        installTray(() => ({ tooltip: t().app.name, show: t().app.trayShow, quit: t().app.trayQuit }));
    }

    <div class="flex h-dvh flex-col">
        <Show when={ platform.isDesktop() }>
            <Titlebar />
        </Show>

        <div class="flex min-h-0 flex-1">
            <SideRail />

            { /* No titlebar on mobile, so the content clears the status bar / notch itself. */ }
            <main class="relative min-w-0 flex-1 overflow-hidden" class:pt-safe={ platform.isMobile() }>
                <ErrorBoundary
                    fallback={ (_error, reset) =>
                        <div class="flex h-full flex-col items-center justify-center gap-4 px-6 text-center">
                            <p class="text-lg font-semibold text-text">{ t().app.crashTitle }</p>
                            <p class="max-w-xs text-sm leading-relaxed text-muted">{ t().app.crashHint }</p>
                            <div class="w-full max-w-40">
                                <Button label={ t().app.crashRetry } block={ true } onPress={ reset } />
                            </div>
                        </div>
                    }
                >
                    <Routes router={ router } />
                </ErrorBoundary>
            </main>

            <TabBar />
        </div>

        <ToastHost />
    </div>
}
