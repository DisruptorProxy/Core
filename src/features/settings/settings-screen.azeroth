import Screen from '../../lib/ui/screen.azeroth';
import Segmented from '../../lib/ui/segmented.azeroth';
import type { SegmentedOption } from '../../lib/ui/segmented.azeroth';
import { useLocale } from '../../stores/locale';
import type { Locale } from '../../stores/locale';
import { useTheme } from '../../stores/theme';
import type { ThemePreference } from '../../stores/theme';

/**
 * Settings is where the theme and language actually live, so both are wired for
 * real from the first phase - they are the two choices that change every other
 * screen, and they are the two things this app must get right for a Persian user.
 */
export default component SettingsScreen()
{
    const { t, locale, setLocale } = useLocale();
    const { preference, setPreference } = useTheme();

    // Static arrays whose labels are getters: the options never change identity,
    // and each label re-reads the dictionary when the locale does.
    const themeOptions: SegmentedOption[] =
    [
        { value: 'system', label: () => t().settings.themeSystem },
        { value: 'light', label: () => t().settings.themeLight },
        { value: 'dark', label: () => t().settings.themeDark }
    ];

    const localeOptions: SegmentedOption[] =
    [
        { value: 'en', label: () => t().settings.languageEnglish },
        { value: 'fa', label: () => t().settings.languagePersian }
    ];

    <Screen title={ t().settings.title }>
        <div class="flex flex-col gap-8 px-5 py-6">
            <section class="flex flex-col gap-4">
                <h2 class="text-xs font-semibold text-faint ltr:uppercase ltr:tracking-[0.16em]">
                    { t().settings.appearance }
                </h2>

                <div class="flex flex-col gap-2">
                    <p class="text-sm font-medium text-text">{ t().settings.theme }</p>

                    <Segmented
                        label={ t().settings.theme }
                        options={ themeOptions }
                        value={ preference() }
                        onSelect={ (value) => setPreference(value as ThemePreference) }
                    />
                </div>

                <div class="flex flex-col gap-2">
                    <p class="text-sm font-medium text-text">{ t().settings.language }</p>

                    <Segmented
                        label={ t().settings.language }
                        options={ localeOptions }
                        value={ locale() }
                        onSelect={ (value) => setLocale(value as Locale) }
                    />
                </div>
            </section>
        </div>
    </Screen>
}
