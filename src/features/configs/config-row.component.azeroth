import { For, Show } from 'azerothjs';

import { Activity, Check, Star } from 'lucide';

import type { ConfigRow } from '../../lib/db/repo';
import { bucketFor } from '../../lib/health/score';

import { flagIcon } from '../../components/flag';
import { icon } from '../../components/icon';

interface ConfigRowProps
{
    row: ConfigRow;
    selectMode: () => boolean;
    isSelected: () => boolean;
    /** Reactive: the server currently carrying traffic gets a marker. */
    isActive: () => boolean;
    /** Reactive: this row's detail is the one currently open (sheet or side panel) - a
     *  neutral tint, distinct from isActive's accent tint, so "which one am I looking
     *  at" never gets confused with "which one is connected". */
    isOpen: () => boolean;
    /** Reactive EWMA latency in ms, or undefined when untested. */
    latency: () => number | undefined;
    /** Reactive: true while a probe for this row is in flight - shown in place of the value. */
    isPinging: () => boolean;
    /** Tap: toggles selection in select mode, otherwise opens the row. */
    onTap: () => void;
    /** Long-press / right-click: enter select mode with this row ticked. */
    onHold: () => void;
}

// Each protocol carries its own hue so a mixed list scans by colour alone.
// REALITY overrides with the accent: it changes how a server is reached and
// identified, so it outranks the protocol as the thing to notice. `none`/`tls`
// are NOT coloured as danger states: Shadowsocks and VMess encrypt at the
// protocol layer, so "no TLS" is normal, not insecure.
const REALITY_BADGE = 'border-accent/40 text-accent';

const PROTOCOL_BADGE: Record<string, string> =
{
    vless: 'border-sky-500/40 text-sky-600 dark:text-sky-300',
    vmess: 'border-violet-500/40 text-violet-600 dark:text-violet-300',
    trojan: 'border-rose-500/40 text-rose-600 dark:text-rose-300',
    shadowsocks: 'border-emerald-500/40 text-emerald-600 dark:text-emerald-300',
    hysteria2: 'border-amber-500/40 text-amber-600 dark:text-amber-300',
    tuic: 'border-fuchsia-500/40 text-fuchsia-600 dark:text-fuchsia-300'
};

const BADGE = 'inline-flex items-center rounded-md border px-1.5 text-[11px] font-medium leading-5';

// Latency colours by bucket, never by the raw number: the same green/amber/red
// language the whole app uses for health.
const LATENCY_TONE: Record<string, string> =
{
    good: 'text-good',
    fair: 'text-fair',
    poor: 'text-poor',
    unknown: 'text-faint'
};

/**
 * One server, as a fixed-height row. Everything the user needs to judge and pick a
 * server at a glance: a clean name, the facts that were buried in the raw name as
 * badges, and the address as a mono readout. Latency arrives with health in P4.
 */
export default component ConfigRow(props: ConfigRowProps)
{
    const flagCls = flagIcon(props.row.country);

    // Long-press to enter select mode. The timer only fires if the finger stays
    // put: any real scroll moves the pointer and cancels it (onPointerMove below),
    // so dragging the list never accidentally selects. `select-none` +
    // touch-callout-none on the row stop the browser's own text-selection / magnifier
    // popup that a long press would otherwise raise on mobile.
    let holdTimer = 0;
    let startX = 0;
    let startY = 0;
    const MOVE_CANCEL_PX = 10;

    // A short vibration confirms entry into select mode - the standard mobile cue
    // that a long press "took". No-ops where the Vibration API is absent (desktop).
    const fireHold = (): void =>
    {
        if (typeof navigator.vibrate === 'function')
        {
            navigator.vibrate(12);
        }

        props.onHold();
    };

    const startHold = (event: PointerEvent): void =>
    {
        startX = event.clientX;
        startY = event.clientY;
        holdTimer = window.setTimeout(fireHold, 450);
    };

    const cancelHold = (): void => window.clearTimeout(holdTimer);

    const moveHold = (event: PointerEvent): void =>
    {
        if (Math.abs(event.clientX - startX) > MOVE_CANCEL_PX || Math.abs(event.clientY - startY) > MOVE_CANCEL_PX)
        {
            cancelHold();
        }
    };

    // In select mode the whole row is the target and its selected state must read at
    // a glance on a phone - so the entire row tints, not just the checkbox.
    const rowClass = (): string =>
    {
        const base = 'flex h-full select-none items-center gap-3 border-b border-border px-4 transition-colors [-webkit-touch-callout:none]';

        if (props.selectMode() && props.isSelected())
        {
            return `${ base } bg-accent-soft`;
        }

        if (props.isActive())
        {
            return `${ base } bg-accent-soft active:bg-accent-soft/80`;
        }

        // Open (viewing this row's detail) is a calm, neutral tint - accent-soft is
        // reserved for "connected" so the two states never read as the same thing.
        return props.isOpen() ? `${ base } bg-elevated active:bg-elevated/80` : `${ base } active:bg-elevated`;
    };

    <div
        class={ rowClass }
        role="button"
        tabindex="0"
        aria-pressed={ () => props.selectMode() ? (props.isSelected() ? 'true' : 'false') : undefined }
        onClick={ () => props.onTap() }
        onKeyDown={ (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); props.onTap(); } } }
        onPointerDown={ (event) => startHold(event) }
        onPointerMove={ (event) => moveHold(event) }
        onPointerUp={ () => cancelHold() }
        onPointerCancel={ () => cancelHold() }
        onPointerLeave={ () => cancelHold() }
        onContextMenu={ (event) => { event.preventDefault(); props.onHold(); } }
    >
        <Show when={ props.isActive() }>
            <span class="h-10 w-1.5 shrink-0 rounded-full bg-accent shadow-[0_0_10px_rgba(0,191,122,0.40)]" aria-hidden="true"></span>
        </Show>

        <Show when={ props.selectMode() }>
            <span
                class={ 'flex size-6 shrink-0 items-center justify-center rounded-md border transition-colors '
                    + (props.isSelected() ? 'border-accent bg-accent text-accent-ink' : 'border-border-strong') }
                aria-hidden="true"
            >
                <Show when={ props.isSelected() }>
                    { icon(Check, 'size-4') }
                </Show>
            </span>
        </Show>

        <Show when={ flagCls }>
            <span class={ `${ flagCls } shrink-0 flag-row` }></span>
        </Show>

        <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span class="truncate text-sm font-medium text-text">{ props.row.name }</span>

            <span class="readout truncate text-xs text-faint" dir="ltr">
                { props.row.host }:{ props.row.port }
            </span>
        </div>

        <div class="flex shrink-0 items-center gap-1.5">
            <Show when={ props.isPinging() }>
                <span class="flex w-12 items-center justify-end text-muted" aria-label="Pinging">
                    { icon(Activity, 'size-3.5 animate-pulse') }
                </span>
            </Show>

            <Show when={ !props.isPinging() && props.latency() !== undefined }>
                <span class={ `readout w-12 text-end text-xs font-medium ${ LATENCY_TONE[bucketFor(props.latency())] ?? '' }` }>
                    { props.latency() }ms
                </span>
            </Show>

            <Show when={ props.row.favorite }>
                { icon(Star, 'size-4 text-fair') }
            </Show>

            <For each={ props.row.tags.slice(0, 1) } key={ (tag) => tag }>
                { (tag) =>
                    <span class={ `${ BADGE } border-border text-muted` }>{ tag }</span>
                }
            </For>

            <span class={ `${ BADGE } uppercase ${ props.row.security === 'reality' ? REALITY_BADGE : PROTOCOL_BADGE[props.row.protocol] ?? 'border-border text-muted' }` }>
                { props.row.security === 'reality' ? 'REALITY' : props.row.protocol }
            </span>
        </div>
    </div>
}
