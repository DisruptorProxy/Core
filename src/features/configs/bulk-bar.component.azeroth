import { CheckCheck, Trash2, X } from 'lucide';

import { icon } from '../../components/icon';
import Tooltip from '../../components/tooltip.component.azeroth';

import { useConfigs } from '../../stores/configs';
import { useLocale } from '../../stores/locale';
import { useSelection } from '../../stores/selection';
import { useToast } from '../../stores/toast';

interface BulkBarProps
{
    /** The ids currently passing the filters - the target of "select all". */
    visibleIds: () => string[];
}

const ACTION = 'flex min-h-11 items-center gap-1.5 rounded-lg px-3 text-sm font-medium press';

/**
 * The action bar that makes "delete 3000 dead configs" a real operation. It docks
 * above the tab bar in select mode and disappears otherwise. "Select all" targets
 * the FILTERED set, not the whole catalogue - so you can filter to one dead
 * subscription and clear exactly it.
 */
export default component BulkBar(props: BulkBarProps)
{
    const { t } = useLocale();
    const selection = useSelection();
    const configs = useConfigs();
    const toast = useToast();

    const removeSelected = async (): Promise<void> =>
    {
        const ids = [...selection.selected()];

        selection.clear();

        // The bar has already closed, so the toast is the only confirmation - and the only
        // report of a failure. Unhandled, a storage error left the user looking at a list
        // that still held everything they just asked to delete, with nothing said.
        try
        {
            await configs.remove(ids);
            toast.success(t().servers.deletedLabel(ids.length));
        }
        catch (error)
        {
            console.error('[disruptor-proxy] bulk delete failed:', error);
            toast.error(t().common.actionFailed);
        }
    };

    <div class="pb-safe fixed inset-x-0 bottom-0 z-30 border-t border-border bg-elevated/95 backdrop-blur md:bottom-0">
        <div class="mx-auto flex max-w-3xl items-center gap-2 px-3 py-2">
            <button type="button" class={ ACTION + ' shrink-0 text-muted hover:bg-surface' } onClick={ () => selection.clear() }>
                { icon(X, 'size-4') }
                { t().servers.cancel }
            </button>

            <span class="readout min-w-0 flex-1 truncate text-center text-sm text-muted">
                { t().servers.selectedLabel(selection.count()) }
            </span>

            <Tooltip label={ t().servers.selectAll }>
                <button
                    type="button"
                    class="flex size-11 shrink-0 items-center justify-center rounded-lg text-muted hover:bg-surface press"
                    aria-label={ t().servers.selectAll }
                    onClick={ () => selection.selectMany(props.visibleIds()) }
                >
                    { icon(CheckCheck, 'size-5') }
                </button>
            </Tooltip>

            <button
                type="button"
                class="flex min-h-11 shrink-0 items-center gap-1.5 rounded-lg bg-poor px-4 text-sm font-medium text-white press disabled:opacity-40"
                disabled={ selection.count() === 0 }
                onClick={ () => void removeSelected() }
            >
                { icon(Trash2, 'size-4') }
                { t().servers.delete }
            </button>
        </div>
    </div>
}
