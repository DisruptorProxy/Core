import { Show } from 'azerothjs';

import { Copy, Power, Server, Star, Trash2 } from 'lucide';

import { canConnect } from '../../lib/xray/config';

import { useConnection } from '../../stores/connection';
import { useDetail } from '../../stores/detail';
import { useLocale } from '../../stores/locale';

import Button from '../../components/button.component.azeroth';
import Card from '../../components/card.component.azeroth';
import { flagIcon } from '../../components/flag';
import { icon } from '../../components/icon';
import PingMenu from '../../components/ping-menu.component.azeroth';

import LatencyCell from './latency-cell.component.azeroth';

const FIELD = 'flex items-center justify-between gap-3 border-b border-border py-2 last:border-0';
const KEY = 'text-xs text-muted';
const VAL = 'readout truncate text-sm text-text';

/**
 * The detail BODY - everything about one server and everything you can do with it.
 * All state and actions live in the detail store, so this renders the same in both
 * presentations: the bottom sheet on phones and the side panel on wide windows.
 * When no server is selected (only reachable in the always-present wide panel) it
 * shows an empty state; a still-loading selection renders nothing (no flash).
 */
export default component ConfigDetail()
{
    const { t } = useLocale();
    const detail = useDetail();
    const connection = useConnection();

    const config = (): ReturnType<typeof detail.config> => detail.config();
    const isActive = (): boolean =>
    {
        const id = config()?.id;

        return id !== undefined && connection.activeId() === id
            && (connection.phase() === 'connected' || connection.phase() === 'connecting');
    };
    const isSwitching = (): boolean => connection.switching();

    <Show
        when={ config() }
        fallback={ () => detail.openId() === null ? emptyState(t().detail.emptyTitle, t().detail.emptyHint) : null }
    >
        { (config) =>
        <div class="flex flex-col gap-4">
            <div class="flex items-center gap-2">
                <Show when={ flagIcon(config().country) }>
                    <span class={ `${ flagIcon(config().country) } flag-detail` }></span>
                </Show>
                <span class="readout truncate text-sm text-faint" dir="ltr">{ config().host }:{ config().port }</span>
            </div>

            <Card class="px-3">
                <div class={ FIELD }>
                    <span class={ KEY }>{ t().detail.protocol }</span>
                    <span class={ `${ VAL } uppercase` }>{ config().protocol }</span>
                </div>
                <div class={ FIELD }>
                    <span class={ KEY }>{ t().detail.transport }</span>
                    <span class={ VAL }>{ config().transport }</span>
                </div>
                <div class={ FIELD }>
                    <span class={ KEY }>{ t().detail.security }</span>
                    <span class={ VAL }>{ config().security }</span>
                </div>
                <div class={ FIELD }>
                    <span class={ KEY }>{ t().detail.source }</span>
                    <span class={ VAL }>{ detail.sourceName() }</span>
                </div>
            </Card>

            <Card class="flex flex-col gap-3 p-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-muted">{ t().detail.health }</span>

                    <PingMenu
                        variant="button"
                        label={ t().detail.ping }
                        text={ () => detail.pinging() ? t().detail.pinging : t().detail.ping }
                        busy={ () => detail.pinging() }
                        disabled={ () => detail.pinging() }
                        proxyDisabled={ () => !canConnect(config().protocol) }
                        tcpLabel={ t().ping.tcp }
                        proxyLabel={ t().ping.proxy }
                        onPick={ (mode) => void detail.pingNow(mode) }
                    />
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <LatencyCell label={ t().ping.tcpLabel } stats={ () => detail.record()?.tcp } untested={ t().detail.untested } successLabel={ t().detail.successRate } />
                    <LatencyCell label={ t().ping.proxyLabel } stats={ () => detail.record()?.proxy } untested={ t().detail.untested } successLabel={ t().detail.successRate } />
                </div>
            </Card>

            <Show when={ !canConnect(config().protocol) }>
                <p class="rounded-xl border border-fair/40 bg-fair/5 px-3 py-2 text-xs text-fair">
                    { t().detail.notSupported }
                </p>
            </Show>

            <div class="grid grid-cols-2 gap-2">
                <Show when={ isSwitching() }>
                    <Button
                        label={ t().home.switching }
                        leading={ Power }
                        block={ true }
                        disabled={ true }
                        onPress={ () => {} }
                    />
                </Show>
                <Show when={ !isSwitching() }>
                    <Show when={ isActive() }>
                        <Button
                            label={ t().detail.disconnect }
                            leading={ Power }
                            variant="danger"
                            block={ true }
                            onPress={ () => void connection.disconnect() }
                        />
                    </Show>
                    <Show when={ !isActive() }>
                        <Button
                            label={ t().detail.connect }
                            leading={ Power }
                            block={ true }
                            disabled={ !canConnect(config().protocol) }
                            onPress={ () => void detail.connect() }
                        />
                    </Show>
                </Show>

                <button
                    type="button"
                    class="flex min-h-11 items-center justify-center gap-2 rounded-xl border border-border text-sm font-medium text-text hover:bg-elevated press"
                    onClick={ () => detail.toggleFavorite() }
                >
                    { icon(Star, detail.favorite() ? 'size-[18px] text-fair' : 'size-[18px]') }
                    { detail.favorite() ? t().detail.removeFavorite : t().detail.addFavorite }
                </button>

                <button
                    type="button"
                    class="flex min-h-11 items-center justify-center gap-2 rounded-xl border border-border text-sm font-medium text-text hover:bg-elevated press"
                    onClick={ () => void detail.copyLink() }
                >
                    { icon(Copy, 'size-[18px]') }
                    { detail.copied() ? t().detail.copied : t().detail.copyLink }
                </button>

                <button
                    type="button"
                    class="flex min-h-11 items-center justify-center gap-2 rounded-xl border border-poor/40 text-sm font-medium text-poor hover:bg-poor/10 press"
                    onClick={ () => void detail.remove() }
                >
                    { icon(Trash2, 'size-[18px]') }
                    { t().detail.delete }
                </button>
            </div>
        </div>
        }
    </Show>
}

/** The "nothing selected" state shown in the wide side panel. */
const emptyState = (title: string, hint: string): HTMLElement =>
{
    const wrap = document.createElement('div');

    wrap.className = 'flex h-full flex-col items-center justify-center gap-3 px-6 text-center';
    wrap.appendChild(icon(Server, 'size-8 text-faint'));

    const heading = document.createElement('p');

    heading.className = 'text-sm font-medium text-muted';
    heading.textContent = title;
    wrap.appendChild(heading);

    const sub = document.createElement('p');

    sub.className = 'max-w-52 text-xs text-faint';
    sub.textContent = hint;
    wrap.appendChild(sub);

    return wrap;
};
