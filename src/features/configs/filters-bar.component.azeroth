import { Show, createRef, onCleanup } from 'azerothjs';

import { Search } from 'lucide';

import type { SortKey } from '../../lib/search/filter';

import FilterMenu from '../../components/filter-menu.component.azeroth';
import type { FilterOption } from '../../components/filter-options.component.azeroth';
import Input from '../../components/input.component.azeroth';

import { useLocale } from '../../stores/locale';
import { useServerQuery } from '../../stores/query';
import { useSubscriptions } from '../../stores/subscriptions';

const CHIP = 'shrink-0 rounded-full border px-3 py-1 text-xs font-medium press';

/** Sentinel for the "All sources" row - maps to a null subscription filter. */
const SOURCE_ALL = '';

/**
 * Search, facet pickers, and sort - the tools that make 8000 servers navigable.
 * Search is debounced in the store; the pickers and sort apply immediately. Protocol
 * and source are dropdowns rather than chip rails, so a hundred subscriptions stay
 * usable instead of becoming an endless horizontal scroll.
 */
export default component FiltersBar()
{
    const { t } = useLocale();
    const query = useServerQuery();
    const subscriptions = useSubscriptions();

    const searchRef = createRef<HTMLDivElement>();

    // Ctrl/Cmd+F focuses the search, the one shortcut a list of 8000 rows really wants.
    // The key is already swallowed in production (src/main.ts blocks the native find bar),
    // so this gives it a purpose instead of leaving it dead. Escape hands focus back, so
    // the keyboard is never parked in the field.
    const onShortcut = (event: KeyboardEvent): void =>
    {
        if ((event.ctrlKey || event.metaKey) && (event.key === 'f' || event.key === 'F'))
        {
            event.preventDefault();
            searchRef.current?.querySelector('input')?.focus();
        }
    };

    document.addEventListener('keydown', onShortcut);
    onCleanup(() => document.removeEventListener('keydown', onShortcut));

    const sortOptions = (): FilterOption[] =>
    [
        { value: 'subscription', label: t().servers.sortSubscription },
        { value: 'name', label: t().servers.sortName },
        { value: 'latency', label: t().servers.sortLatency },
        { value: 'country', label: t().servers.sortCountry }
    ];

    const sortSummary = (): string =>
    {
        const key = query.sort();

        if (key === 'name') {return t().servers.sortName;}
        if (key === 'latency') {return t().servers.sortLatency;}
        if (key === 'country') {return t().servers.sortCountry;}

        return t().servers.sortSubscription;
    };

    const protocolOptions = (): FilterOption[] =>
        query.facets().protocols.map((protocol) => ({ value: protocol, label: protocol.toUpperCase() }));

    const protocolSummary = (): string =>
    {
        const set = query.protocols();

        if (set.size === 0)
        {
            return t().servers.all;
        }

        if (set.size === 1)
        {
            return [...set][0].toUpperCase();
        }

        return String(set.size);
    };

    const sourceOptions = (): FilterOption[] =>
    [
        { value: SOURCE_ALL, label: t().servers.allSources },
        ...subscriptions.subs().map((sub) => ({ value: sub.id, label: sub.name }))
    ];

    const sourceSummary = (): string =>
    {
        const id = query.subId();

        if (id === null)
        {
            return t().servers.all;
        }

        return subscriptions.subs().find((sub) => sub.id === id)?.name ?? t().servers.all;
    };

    <div class="flex flex-col gap-3">
        { /* The ref lands on a wrapper, not the Input: the field is a component, and
             reaching for its element is not part of its contract. */ }
        <div ref={ searchRef }>
            <Input
                type="search"
                leading={ Search }
                placeholder={ t().servers.searchPlaceholder }
                value={ query.query() }
                onInput={ (value) => query.setQuery(value) }
            />
        </div>

        <div class="flex flex-wrap gap-2">
            <button
                type="button"
                class={ `${ CHIP } ${ query.favoritesOnly()
                    ? 'border-fair/50 bg-fair/10 text-fair'
                    : 'border-border text-muted hover:bg-elevated' }` }
                onClick={ () => query.setFavoritesOnly(!query.favoritesOnly()) }
            >
                { t().servers.favoritesOnly }
            </button>

            <FilterMenu
                label={ t().servers.protocol }
                summary={ protocolSummary }
                active={ () => query.protocols().size > 0 }
                options={ protocolOptions }
                selected={ (value) => query.protocols().has(value) }
                onSelect={ (value) => query.toggleProtocol(value) }
                multi={ true }
            />

            <Show when={ subscriptions.subs().length > 0 }>
                <FilterMenu
                    label={ t().servers.source }
                    summary={ sourceSummary }
                    active={ () => query.subId() !== null }
                    options={ sourceOptions }
                    selected={ (value) => (value === SOURCE_ALL ? query.subId() === null : query.subId() === value) }
                    onSelect={ (value) => query.setSubId(value === SOURCE_ALL ? null : value) }
                    searchable={ subscriptions.subs().length > 8 }
                    searchPlaceholder={ t().servers.searchSource }
                />
            </Show>

            <FilterMenu
                label={ t().servers.sort }
                summary={ sortSummary }
                active={ () => query.sort() !== 'subscription' }
                options={ sortOptions }
                selected={ (value) => query.sort() === value }
                onSelect={ (value) => query.setSort(value as SortKey) }
            />
        </div>
    </div>
}
