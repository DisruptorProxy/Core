import { For } from 'azerothjs';

import Button from '../../components/button.component.azeroth';
import Segmented from '../../components/segmented.component.azeroth';
import type { SegmentedOption } from '../../components/segmented.component.azeroth';
import Sheet from '../../components/sheet.component.azeroth';
import type { MatchType, Rule, RuleAction } from '../../lib/routing/types';
import { useLocale } from '../../stores/locale';

interface RuleEditorProps
{
    open: () => boolean;
    initial: () => Rule | null;
    onClose: () => void;
    onSubmit: (type: MatchType, value: string, action: RuleAction) => void;
}

// `final` is the pinned catch-all - it is never user-created, so it is not offered.
const EDITABLE_TYPES: MatchType[] = ['domain-suffix', 'domain', 'domain-keyword', 'geosite', 'geoip', 'ip-cidr', 'process'];

const FIELD = 'min-h-11 w-full rounded-xl border border-border bg-surface px-3 text-sm text-text outline-none focus:border-accent';

export default component RuleEditor(props: RuleEditorProps)
{
    const { t } = useLocale();

    state type = 'domain-suffix' as MatchType;
    state value = '';
    state action = 'direct' as RuleAction;

    const typeLabel = (mt: MatchType): string =>
    {
        const r = t().routing;
        const labels: Record<string, string> =
        {
            'domain-suffix': r.typeDomainSuffix,
            'domain': r.typeDomain,
            'domain-keyword': r.typeDomainKeyword,
            'geosite': r.typeGeosite,
            'geoip': r.typeGeoip,
            'ip-cidr': r.typeIpCidr,
            'process': r.typeProcess
        };

        return labels[mt] ?? mt;
    };

    // Seed from the rule being edited each time the sheet opens.
    effect {
        if (props.open())
        {
            const rule = props.initial();

            type = rule?.type ?? 'domain-suffix';
            value = rule?.value ?? '';
            action = rule?.action ?? 'direct';
        }
    }

    const actionOptions: SegmentedOption[] =
    [
        { value: 'proxy', label: () => t().routing.actionProxy },
        { value: 'direct', label: () => t().routing.actionDirect },
        { value: 'block', label: () => t().routing.actionBlock }
    ];

    const submit = (): void =>
    {
        if (value.trim() === '')
        {
            return;
        }

        props.onSubmit(type, value.trim(), action);
    };

    derived title = props.initial() === null ? t().routing.addRule : t().routing.editRule;

    <Sheet open={ props.open } onClose={ props.onClose } title={ title }>
        <div class="flex flex-col gap-4">
            <label class="flex flex-col gap-1.5">
                <span class="text-xs font-medium text-muted">{ t().routing.matchType }</span>
                <select
                    class={ FIELD }
                    value={ type }
                    onChange={ (event) => type = (event.target as HTMLSelectElement).value as MatchType }
                >
                    <For each={ EDITABLE_TYPES } key={ (mt) => mt }>
                        { (mt) =>
                            <option value={ mt }>{ typeLabel(mt) }</option>
                        }
                    </For>
                </select>
            </label>

            <label class="flex flex-col gap-1.5">
                <span class="text-xs font-medium text-muted">{ t().routing.matchValue }</span>
                <input
                    class={ FIELD }
                    type="text"
                    dir="ltr"
                    placeholder={ t().routing.matchValuePlaceholder }
                    bind:value={ value }
                />
            </label>

            <div class="flex flex-col gap-1.5">
                <span class="text-xs font-medium text-muted">{ t().routing.action }</span>
                <Segmented
                    label={ t().routing.action }
                    options={ actionOptions }
                    value={ action }
                    onSelect={ (v) => action = v as RuleAction }
                />
            </div>

            <div class="mt-1 flex gap-2">
                <Button label={ t().routing.cancel } variant="ghost" block={ true } onPress={ props.onClose } />
                <Button label={ t().routing.save } block={ true } disabled={ value.trim() === '' } onPress={ () => submit() } />
            </div>
        </div>
    </Sheet>
}
