import { createEffect } from 'azerothjs';

import { GATE_SPRING, motion } from '../../lib/motion/presets';

import type { ConnectionPhase } from './engine/port';
import { GIRIH } from './girih-geometry';

interface GateProps
{
    phase: () => ConnectionPhase;
}

/**
 * The girih gate - the app's one signature. A pierced screen that lights and opens
 * as the connection establishes: idle is a dim closed lattice, connecting sets the
 * interlaced stars turning, connected lights the whole rosette and opens its core.
 * All state is CSS driven off `data-phase`, so the reduced-motion guard stops the
 * motion without any code here.
 */
export default component ConnectionGate(props: GateProps)
{
    // The core's scale is a spring, not a CSS transition, so a fast connect ->
    // disconnect reverses it in-flight instead of snapping. Everything else on the
    // gate stays CSS-driven off data-phase. motion() carries the reduced-motion
    // contract, so the core still lands on the right size instantly there.
    let core: Element | null = null;

    const bindCore = (element: Element): void => { core = element; };

    createEffect(() =>
    {
        const open = props.phase() === 'connected';

        if (core !== null)
        {
            motion(core, { scale: open ? 1.7 : 1 }, GATE_SPRING);
        }
    });

    <svg
        class="g-gate size-56"
        viewBox="0 0 200 200"
        data-phase={ props.phase() }
        aria-hidden="true"
    >
        <polygon class="g-frame" points={ GIRIH.frame } />
        <polygon class="g-rosette" points={ GIRIH.rosette } />
        <polygon class="g-weave" points={ GIRIH.weave } />
        <polygon ref={ bindCore } class="g-core" points={ GIRIH.core } />
    </svg>
}
