import { Show } from 'azerothjs';

import { Pencil, RefreshCw, Trash2 } from 'lucide';

import type { SubscriptionRecord, SubscriptionUserinfo } from '../../lib/db/schema';
import { formatBytes } from '../../lib/format/bytes';

import { useLocale } from '../../stores/locale';
import { useSubscriptions } from '../../stores/subscriptions';

import Card from '../../components/card.component.azeroth';
import { icon } from '../../components/icon';
import { isStale, relativeTime } from '../../components/relative-time';

interface SubscriptionCardProps
{
    sub: SubscriptionRecord;
    onEdit: () => void;
    onDelete: () => void;
}

const STATUS_TONE: Record<string, string> =
{
    ok: 'text-good',
    stale: 'text-fair',
    failed: 'text-poor',
    never: 'text-faint'
};

const ICON_BTN = 'flex size-9 items-center justify-center rounded-lg border border-border text-muted hover:bg-elevated press disabled:opacity-40';

/**
 * One subscription. Its freshness is the point: a status word, a relative age, and
 * its server count are all visible without opening anything - so a stale or failed
 * source is obvious at a glance rather than silently rotting.
 */
export default component SubscriptionCard(props: SubscriptionCardProps)
{
    const { t } = useLocale();
    const subscriptions = useSubscriptions();

    const stale = (): boolean => isStale(props.sub.lastUpdatedAt, props.sub.intervalMin);

    const statusText = (): string =>
    {
        if (props.sub.status === 'failed')
        {
            return t().subscriptions.statusFailed;
        }

        if (props.sub.status === 'never')
        {
            return t().subscriptions.statusNever;
        }

        return stale() ? t().subscriptions.statusStale : t().subscriptions.statusOk;
    };

    const statusTone = (): string => STATUS_TONE[props.sub.status === 'ok' && stale() ? 'stale' : props.sub.status];

    const info = (): SubscriptionUserinfo | undefined => props.sub.userinfo;

    const totalBytes = (): number => info()?.total ?? 0;

    const remainingBytes = (): number =>
    {
        const usage = info();

        return usage ? Math.max(usage.total - usage.upload - usage.download, 0) : 0;
    };

    const usedBytes = (): number => Math.max(totalBytes() - remainingBytes(), 0);

    const usedPct = (): number => (totalBytes() > 0 ? Math.min((usedBytes() / totalBytes()) * 100, 100) : 0);

    /** The quota bar's fill colour: calm until the plan is three-quarters gone. */
    const usageTone = (): string =>
    {
        if (usedPct() >= 90)
        {
            return 'bg-poor';
        }

        return usedPct() >= 75 ? 'bg-fair' : 'bg-accent';
    };

    /** Whole days until expiry; <= 0 once past, null when the provider sent no expiry. */
    const daysLeft = (): number | null =>
    {
        const expire = info()?.expire ?? 0;

        return expire > 0 ? Math.ceil((expire * 1000 - Date.now()) / 86_400_000) : null;
    };

    const expiryText = (): string =>
    {
        const days = daysLeft();

        if (days === null)
        {
            return '';
        }

        return days <= 0 ? t().subscriptions.expired : t().subscriptions.daysLeft(days);
    };

    // Only worth a row when the provider actually reported a quota or an expiry.
    const hasUsage = (): boolean => info() !== undefined && (totalBytes() > 0 || daysLeft() !== null);

    <Card class="flex flex-col gap-3 p-4">
        <div class="flex items-start justify-between gap-3">
            <div class="flex min-w-0 flex-col gap-0.5">
                <span class="truncate text-sm font-semibold text-text">{ props.sub.name }</span>
                <span class="readout truncate text-xs text-faint" dir="ltr">{ props.sub.url }</span>
            </div>

            <span class="readout shrink-0 text-xs text-muted">{ t().subscriptions.countLabel(props.sub.configCount) }</span>
        </div>

        <div class="flex items-center justify-between gap-2">
            <div class="flex min-w-0 flex-col">
                <span class={ `text-xs font-medium ${ statusTone() }` }>{ statusText() }</span>

                <Show when={ props.sub.lastUpdatedAt }>
                    <span class="text-[11px] text-faint">
                        { t().subscriptions.updatedAgo(relativeTime(props.sub.lastUpdatedAt!, t())) }
                    </span>
                </Show>

                <Show when={ props.sub.status === 'failed' && props.sub.lastError }>
                    <span class="truncate text-[11px] text-poor">{ props.sub.lastError }</span>
                </Show>
            </div>

            <div class="flex shrink-0 items-center gap-2">
                <button
                    type="button"
                    class={ ICON_BTN }
                    aria-label={ t().subscriptions.update }
                    data-tip={ t().subscriptions.update }
                    disabled={ subscriptions.isUpdating(props.sub.id) }
                    onClick={ () => void subscriptions.update(props.sub.id) }
                >
                    { icon(RefreshCw, subscriptions.isUpdating(props.sub.id) ? 'size-4 animate-spin' : 'size-4') }
                </button>

                <button type="button" class={ ICON_BTN } aria-label={ t().subscriptions.editTitle } data-tip={ t().subscriptions.editTitle } onClick={ () => props.onEdit() }>
                    { icon(Pencil, 'size-4') }
                </button>

                <button type="button" class={ ICON_BTN } aria-label={ t().subscriptions.delete } data-tip={ t().subscriptions.delete } onClick={ () => props.onDelete() }>
                    { icon(Trash2, 'size-4') }
                </button>
            </div>
        </div>

        <Show when={ hasUsage() }>
            <div class="flex flex-col gap-1.5 border-t border-border/60 pt-2.5 text-[11px]">
                <div class="flex items-baseline justify-between gap-2">
                    <Show when={ totalBytes() > 0 } fallback={ () => document.createElement('span') }>
                        <span class="flex items-baseline gap-1 text-muted">
                            <span>{ t().subscriptions.remaining }</span>
                            <span class="readout font-medium text-text" dir="ltr">{ formatBytes(remainingBytes()) }</span>
                        </span>
                    </Show>

                    <Show when={ daysLeft() !== null }>
                        <span class={ `readout font-medium ${ (daysLeft() ?? 0) <= 3 ? 'text-poor' : 'text-muted' }` }>
                            { expiryText() }
                        </span>
                    </Show>
                </div>

                <Show when={ totalBytes() > 0 }>
                    <div class="h-1 w-full overflow-hidden rounded-full bg-border/50">
                        <div class={ `h-full rounded-full ${ usageTone() }` } style:width={ `${ usedPct() }%` }></div>
                    </div>

                    <span class="readout self-end text-faint" dir="ltr">
                        { `${ formatBytes(usedBytes()) } / ${ formatBytes(totalBytes()) }` }
                    </span>
                </Show>
            </div>
        </Show>
    </Card>
}
