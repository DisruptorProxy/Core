import { Match, Show, Switch } from 'azerothjs';

import { CircleStop, Download, Gauge, ListChecks, Server, X } from 'lucide';

import { useConfigs } from '../stores/configs';
import { useDetail } from '../stores/detail';
import { useHealth } from '../stores/health';
import { useLocale } from '../stores/locale';
import { useServerQuery } from '../stores/query';
import { useSelection } from '../stores/selection';
import { useViewport } from '../stores/viewport';

import Button from '../components/button.component.azeroth';
import EmptyState from '../components/empty-state.component.azeroth';
import { icon } from '../components/icon';
import Sheet from '../components/sheet.component.azeroth';

import BulkBar from '../features/configs/bulk-bar.component.azeroth';
import ConfigDetail from '../features/configs/config-detail.component.azeroth';
import ConfigList from '../features/configs/config-list.component.azeroth';
import FiltersBar from '../features/configs/filters-bar.component.azeroth';
import ImportSheet from '../features/import/import-sheet.component.azeroth';

const ICON_BTN = 'flex size-11 items-center justify-center rounded-lg border border-border text-muted hover:bg-elevated';

/**
 * The server catalogue. Unlike the other screens it does NOT use the scrolling
 * Screen scaffold: the list must own a bounded height and scroll internally, or
 * virtualization has nothing to measure. So this is a full-height column - a fixed
 * header, a filter bar, and the list filling the rest.
 */
export default component ServersPage()
{
    const { t } = useLocale();
    const { rows } = useConfigs();
    const query = useServerQuery();
    const selection = useSelection();
    const health = useHealth();
    const detail = useDetail();
    const viewport = useViewport();

    state importOpen = false;

    derived hasServers = rows().length > 0;

    <div class="contents">
    <div class="flex h-full min-h-0">
    <section class="flex h-full min-h-0 min-w-0 flex-1 flex-col pb-14 md:pb-0">
        <header class="glass-bar shrink-0 border-b border-border">
            <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-3 px-5 py-4">
                <div class="flex min-w-0 flex-col gap-0.5">
                    <h1 class="text-lg font-semibold tracking-tight text-text">{ t().servers.title }</h1>

                    <Show
                        when={ health.testState().running }
                        fallback={ () =>
                            <p class="readout text-sm text-muted">{ t().servers.countLabel(query.visibleIds().length) }</p>
                        }
                    >
                        <p class="readout text-sm text-accent">
                            { t().servers.testing(health.testState().done, health.testState().total) }
                        </p>
                    </Show>
                </div>

                <Show when={ !selection.active() }>
                    <div class="flex shrink-0 items-center gap-2">
                        <button
                            type="button"
                            class={ ICON_BTN }
                            aria-label={ t().importing.openAction }
                            data-tip={ t().importing.openAction }
                            onClick={ () => importOpen = true }
                        >
                            { icon(Download, 'size-4') }
                        </button>

                        <Switch>
                            <Match when={ hasServers && health.testState().running }>
                                <button
                                    type="button"
                                    class="flex size-11 items-center justify-center rounded-lg border border-poor/40 text-poor hover:bg-poor/10"
                                    aria-label={ t().servers.stop }
                                    data-tip={ t().servers.stop }
                                    onClick={ () => health.cancel() }
                                >
                                    { icon(CircleStop, 'size-4') }
                                </button>
                            </Match>
                            <Match when={ hasServers }>
                                <button
                                    type="button"
                                    class={ ICON_BTN }
                                    aria-label={ t().servers.test }
                                    data-tip={ t().servers.test }
                                    onClick={ () => void health.test(query.visibleIds()) }
                                >
                                    { icon(Gauge, 'size-4') }
                                </button>
                            </Match>
                        </Switch>

                        <Show when={ hasServers }>
                            <button
                                type="button"
                                class={ ICON_BTN }
                                aria-label={ t().servers.select }
                                data-tip={ t().servers.select }
                                onClick={ () => selection.enter() }
                            >
                                { icon(ListChecks, 'size-4') }
                            </button>
                        </Show>
                    </div>
                </Show>
            </div>
        </header>

        <Show when={ hasServers }>
            <div class="shrink-0 border-b border-border">
                <div class="mx-auto w-full max-w-3xl px-5 py-3">
                    <FiltersBar />
                </div>
            </div>

            <div class="min-h-0 flex-1">
                <div class="mx-auto h-full w-full max-w-3xl">
                    <Show when={ query.visibleIds().length > 0 } fallback={ () => noMatches(t().servers.noMatches) }>
                        <ConfigList />
                    </Show>
                </div>
            </div>
        </Show>

        <Show when={ !hasServers }>
            <div class="flex flex-1 flex-col items-center gap-6 overflow-y-auto px-5 py-10">
                <EmptyState glyph={ Server } title={ t().servers.empty } hint={ t().servers.emptyAction } />

                <div class="w-full max-w-xs">
                    <Button label={ t().importing.openAction } leading={ Download } block={ true } onPress={ () => importOpen = true } />
                </div>
            </div>
        </Show>
    </section>

    <Show when={ viewport.isWide() }>
        <aside class="flex h-full min-h-0 w-80 shrink-0 flex-col border-s border-border">
            <Show when={ detail.openId() }>
                <div class="glass-bar flex shrink-0 items-center justify-between gap-2 border-b border-border px-4 py-4">
                    <span class="truncate text-sm font-semibold text-text">{ detail.config()?.name ?? '' }</span>

                    <button
                        type="button"
                        class="flex size-8 shrink-0 items-center justify-center rounded-lg text-muted hover:bg-surface"
                        aria-label={ t().detail.close }
                        data-tip={ t().detail.close }
                        onClick={ () => detail.close() }
                    >
                        { icon(X, 'size-4') }
                    </button>
                </div>
            </Show>

            <div class="min-h-0 flex-1 overflow-y-auto px-4 py-4">
                <ConfigDetail />
            </div>
        </aside>
    </Show>
    </div>

    <Show when={ selection.active() }>
        <BulkBar visibleIds={ query.visibleIds } />
    </Show>

    <ImportSheet open={ () => importOpen } onClose={ () => importOpen = false } />

    <Show when={ !viewport.isWide() }>
        <Sheet open={ () => detail.openId() !== null } onClose={ () => detail.close() } title={ detail.config()?.name ?? '' }>
            <ConfigDetail />
        </Sheet>
    </Show>
    </div>
}

/** A centred "no results" message, built imperatively for the Show fallback. */
const noMatches = (message: string): HTMLElement =>
{
    const element = document.createElement('div');

    element.className = 'flex h-full items-center justify-center px-8 text-center text-sm text-muted';
    element.textContent = message;

    return element;
};
