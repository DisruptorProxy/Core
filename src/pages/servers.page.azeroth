import { Show, Transition } from 'azerothjs';

import { ChevronsDownUp, ChevronsUpDown, CircleStop, Download, Gauge, ListChecks, Plus, Rss, Server, SlidersHorizontal, X } from 'lucide';

import type { SubscriptionRecord } from '../lib/db/schema';
import { buildUri } from '../lib/proxy/build-uri';
import type { ProxyConfig } from '../lib/proxy/types';
import { ParseFailure } from '../lib/proxy/uri';

import { useConfigs } from '../stores/configs';
import { useConnection } from '../stores/connection';
import { useDetail } from '../stores/detail';
import { useGroups } from '../stores/groups';
import { useHealth } from '../stores/health';
import { useLocale } from '../stores/locale';
import { useServerQuery } from '../stores/query';
import { useSelection } from '../stores/selection';
import { useSubscriptions } from '../stores/subscriptions';
import { useToast } from '../stores/toast';
import { useViewport } from '../stores/viewport';

import Button from '../components/button.component.azeroth';
import EmptyState from '../components/empty-state.component.azeroth';
import { icon } from '../components/icon';
import Sheet from '../components/sheet.component.azeroth';
import Tooltip from '../components/tooltip.component.azeroth';

import BulkBar from '../features/configs/bulk-bar.component.azeroth';
import ConfigDetail from '../features/configs/config-detail.component.azeroth';
import ConfigEditor from '../features/configs/config-editor.component.azeroth';
import type { EditorResult } from '../features/configs/config-editor.component.azeroth';
import ConfigList from '../features/configs/config-list.component.azeroth';
import FiltersBar from '../features/configs/filters-bar.component.azeroth';
import ConnectionStatus from '../features/connection/connection-status.component.azeroth';
import ImportSheet from '../features/import/import-sheet.component.azeroth';
import DeleteDialog from '../features/subscriptions/delete-dialog.component.azeroth';
import SubscriptionEditor from '../features/subscriptions/subscription-editor.component.azeroth';

const ICON_BTN = 'flex size-11 items-center justify-center rounded-lg border border-border text-muted hover:bg-elevated press';

// One action row inside the drawer: a full-width, comfortably tappable target with an
// icon and a clear label - the mobile-first replacement for a cramped row of icons.
const DRAWER_ROW = 'flex w-full items-center gap-3 rounded-xl px-3 py-3 text-start text-sm font-medium text-text hover:bg-elevated press';

/**
 * The server workspace: every server the app knows, grouped under the subscription it came
 * from (collapsible), with manually-imported servers under their own group. This one page
 * absorbed the old separate Subscriptions screen - adding, editing, updating and deleting a
 * source all happen here, on its group header - so there is a single place servers live.
 *
 * Like the list it owns, it does NOT use the scrolling Screen scaffold: the list must own a
 * bounded height and scroll internally, or virtualization has nothing to measure. So this is
 * a full-height column - a fixed header, a filter bar, and the grouped list filling the rest.
 */
export default component ServersPage()
{
    const { t } = useLocale();
    const { rows } = useConfigs();
    const query = useServerQuery();
    const selection = useSelection();
    const health = useHealth();
    const detail = useDetail();
    const connection = useConnection();
    const subscriptions = useSubscriptions();
    const groups = useGroups();
    const viewport = useViewport();
    const configs = useConfigs();
    const toast = useToast();

    state importOpen = false;
    state actionsOpen = false;
    state editorOpen = false;
    state editing = null as SubscriptionRecord | null;
    state deleteTarget = null as SubscriptionRecord | null;
    state editorOpenManual = false;
    state editorTarget = null as ProxyConfig | null;
    state editorReplace = null as ProxyConfig | null;

    /**
     * Builds the link from the form and hands it to the parser, so a typed server takes the
     * exact path a pasted one does. `editorTarget` is passed as the id to replace: an
     * endpoint edit legitimately produces a different server, so the old row goes.
     */
    const submitManual = async (result: EditorResult): Promise<void> =>
    {
        editorOpenManual = false;

        // JSON arrives already as a link; the form has to be built into one first.
        if (result.kind === 'uri')
        {
            const saved = await configs.saveManual(result.uri, editorReplace?.id);

            if (saved instanceof ParseFailure)
            {
                toast.error(saved.message);
            }

            return;
        }

        const values = result.values;

        const draft = {
            ...values,
            port: Number(values.port),
            name: values.name.trim() === '' ? values.host : values.name,
            rawUri: '',
            id: '',
            tags: [],
            favorite: false,
            addedAt: Date.now()
        } as unknown as ProxyConfig;

        const saved = await configs.saveManual(buildUri(draft), editorReplace?.id);

        // No success toast: the row appearing in the list and the sheet closing already say
        // it worked. A failure has no such signal, so that one speaks.
        if (saved instanceof ParseFailure)
        {
            toast.error(saved.message);
        }
    };

    /**
     * Opens the editor on an existing server. A DUPLICATE passes no replace target and
     * clears the name, so saving adds a second server instead of consuming the first -
     * which is the whole point of trying a variant.
     */
    const openManualEditor = (config: ProxyConfig, duplicate: boolean): void =>
    {
        detail.close();
        editorTarget = duplicate ? { ...config, name: '' } as ProxyConfig : config;
        editorReplace = duplicate ? null : config;
        editorOpenManual = true;
    };

    derived hasServers = rows().length > 0;
    // The grouped list appears whenever there is anything to organise - servers, or even a
    // subscription with nothing under it yet (its empty header still belongs on screen).
    derived hasList = rows().length > 0 || subscriptions.subs().length > 0;
    derived canTest = rows().length > 0 && !health.testState().running;
    derived isTesting = rows().length > 0 && health.testState().running;

    const openAddSub = (): void =>
    {
        editing = null;
        editorOpen = true;
    };

    const openEditSub = (sub: SubscriptionRecord): void =>
    {
        editing = sub;
        editorOpen = true;
    };

    const submitSub = async (url: string, name: string, intervalMin: number): Promise<void> =>
    {
        const current = editing;

        editorOpen = false;

        if (current === null)
        {
            const id = await subscriptions.add(url, name, intervalMin);

            // A brand-new subscription updates immediately - adding a source whose servers
            // the user cannot see is a dead end.
            await subscriptions.update(id);
        }
        else
        {
            await subscriptions.edit({ ...current, url, name: name.trim() === '' ? current.name : name, intervalMin });
        }
    };

    const confirmDelete = async (keepConfigs: boolean): Promise<void> =>
    {
        const target = deleteTarget;

        deleteTarget = null;

        if (target !== null)
        {
            await subscriptions.remove(target.id, keepConfigs);
        }
    };

    // Collapse-all is a single toggle: if everything is already closed, open it all.
    const allCollapsed = (): boolean =>
    {
        const keys = query.groupKeys();

        return keys.length > 0 && keys.every((key) => groups.isCollapsed(key));
    };

    const toggleAll = (): void =>
    {
        if (allCollapsed())
        {
            groups.expandAll();
        }
        else
        {
            groups.collapseAll(query.groupKeys());
        }
    };

    // The side panel's live block: visible whenever a session is up or forming,
    // so connecting never empties the panel - it gains the connection instead.
    derived liveVisible = connection.activeConfig() !== null
        && (connection.phase() === 'connected' || connection.phase() === 'connecting' || connection.switching());

    derived liveSettled = connection.phase() === 'connected' && !connection.switching();

    /** The wide-layout side panel is open only for a chosen server. */
    derived panelOpen = detail.openId() !== null;

    const liveLabel = (): string =>
    {
        if (connection.switching())
        {
            return t().home.switching;
        }

        return connection.phase() === 'connecting' ? t().home.connecting : t().home.connected;
    };

    { /* A real block root (not `contents`): the route transition animates THIS element,
         and a display:contents box cannot paint a transform or fade. */ }
    <div class="h-full">
        <div class="flex h-full min-h-0">
            <section class="flex h-full min-h-0 min-w-0 flex-1 flex-col pb-14 md:pb-0">
                <header class="glass-bar relative z-30 shrink-0 border-b border-border">
                    <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-3 px-5 py-4">
                        <div class="flex min-w-0 flex-col gap-0.5">
                            <h1 class="text-lg font-semibold tracking-tight text-text">{ t().servers.title }</h1>

                            <Show
                                when={ health.testState().running }
                                fallback={ () =>
                            <p class="readout text-sm text-muted">{ t().servers.countLabel(query.visibleIds().length) }</p>
                        }
                            >
                                <p class="readout text-sm text-accent">
                            { t().servers.testing(health.testState().done, health.testState().total) }
                                </p>
                            </Show>
                        </div>

                { /* Import earns its own button: it is how servers first get here, so it must
                     not be buried a tap deep. Everything else stays behind the one drawer
                     trigger (bottom sheet on phones, centred card on wide) - roomy, labelled
                     targets rather than five cryptic glyphs fighting for space beside the
                     title. A live test shows its progress in the subtitle above. */ }
                        <Show when={ !selection.active() }>
                            <div class="flex shrink-0 items-center gap-2">
                                <Tooltip label={ t().importing.openAction }>
                                    <button
                                        type="button"
                                        class={ ICON_BTN }
                                        aria-label={ t().importing.openAction }
                                        onClick={ () => importOpen = true }
                                    >
                                        { icon(Download, 'size-4') }
                                    </button>
                                </Tooltip>

                                <Tooltip label={ t().servers.actions }>
                                    <button
                                        type="button"
                                        class={ `${ ICON_BTN } relative` }
                                        aria-label={ t().servers.actions }
                                        onClick={ () => actionsOpen = true }
                                    >
                                        { icon(SlidersHorizontal, 'size-4') }

                                        <Show when={ isTesting }>
                                            <span class="absolute end-1.5 top-1.5 size-2 animate-pulse rounded-full bg-accent" aria-hidden="true"></span>
                                        </Show>
                                    </button>
                                </Tooltip>
                            </div>
                        </Show>
                    </div>
                </header>

        { /* Body laid out like the Connect screen: a centred max-w-3xl column with generous
             padding, the filter bar and any notices floating above the list rather than as
             full-bleed bordered strips, and the list itself contained in a glass card - the
             same raised surface Connect uses for its status card. */ }
                <Show when={ hasServers }>
                    <div class="mx-auto w-full max-w-3xl shrink-0 px-5 pt-5">
                        <FiltersBar />
                    </div>
                </Show>

                <Show when={ subscriptions.error() }>
                    <div class="mx-auto w-full max-w-3xl shrink-0 px-5 pt-5">
                        <p class="rounded-xl border border-poor/40 bg-poor/5 px-3 py-2 text-sm text-poor">{ subscriptions.error() }</p>
                    </div>
                </Show>

        { /* The card wraps its content instead of filling the column: collapse every group
             and it shrinks to the handful of headers left, rather than leaving a tall pane of
             empty glass under them. `max-h-full` keeps it inside the viewport, and the list
             inside scrolls once the content is taller than that. */ }
                <Show when={ hasList }>
                    <div class="min-h-0 flex-1">
                        <div class="mx-auto h-full w-full max-w-3xl px-5 py-5">
                            <div class="glass flex max-h-full flex-col overflow-hidden rounded-2xl">
                                <Show
                                    when={ query.visibleItems().length > 0 }
                                    fallback={
                                <div class="flex items-center justify-center px-8 py-12 text-center text-sm text-muted">
                                    { t().servers.noMatches }
                                </div>
                            }
                                >
                                    <ConfigList onEditSub={ openEditSub } onDeleteSub={ (sub) => deleteTarget = sub } />
                                </Show>
                            </div>
                        </div>
                    </div>
                </Show>

                <Show when={ !hasList }>
                    <div class="flex flex-1 flex-col items-center gap-6 overflow-y-auto px-5 py-10">
                        <EmptyState glyph={ Server } title={ t().servers.empty } hint={ t().servers.emptyAction } />

                        <div class="flex w-full max-w-xs flex-col gap-3">
                            <Button label={ t().subscriptions.add } leading={ Rss } block={ true } onPress={ () => openAddSub() } />
                            <Button label={ t().importing.openAction } leading={ Download } variant="ghost" block={ true } onPress={ () => importOpen = true } />
                        </div>
                    </div>
                </Show>
            </section>

    { /* The panel is not a permanent fixture: with no server open it holds nothing worth
         320px, so it collapses to zero and the list takes the whole width. Picking a server
         slides it back out. The inner column keeps its full width throughout, so the content
         slides rather than reflowing mid-animation. */ }
            <Show when={ viewport.isWide() }>
                <aside
                    class={ () => `flex h-full min-h-0 shrink-0 overflow-hidden transition-[width] duration-300 ${ panelOpen ? 'w-80 border-s border-border' : 'w-0' }` }
                    aria-hidden={ () => panelOpen ? 'false' : 'true' }
                >
                    <div class="flex h-full min-h-0 w-80 shrink-0 flex-col">
                        <Show when={ liveVisible }>
                            <div class="shrink-0 border-b border-border px-4 py-4">
                                <div class="mb-3 flex items-center justify-center gap-2">
                                    <span class={ () => `size-1.5 rounded-full ${ liveSettled ? 'bg-good' : 'animate-pulse bg-accent' }` }></span>
                                    <span class={ () => `text-xs font-semibold ${ liveSettled ? 'text-good' : 'text-accent' }` }>{ liveLabel() }</span>
                                </div>

                                <ConnectionStatus />
                            </div>
                        </Show>

            { /* The panel closes from here: now that it collapses away, a chosen server
                 needs a way back to the full-width list. */ }
                        <Show when={ detail.openId() }>
                            <div class="glass-bar flex shrink-0 items-center gap-2 border-b border-border px-4 py-4">
                                <span class="min-w-0 flex-1 truncate text-sm font-semibold text-text">{ detail.config()?.name ?? '' }</span>

                                <Tooltip label={ t().common.dismiss }>
                                    <button
                                        type="button"
                                        class="flex size-7 shrink-0 items-center justify-center rounded-lg text-muted hover:bg-elevated hover:text-text press"
                                        aria-label={ t().common.dismiss }
                                        onClick={ () => detail.close() }
                                    >
                                        { icon(X, 'size-4') }
                                    </button>
                                </Tooltip>
                            </div>
                        </Show>

                        <div class="min-h-0 flex-1 overflow-y-auto px-4 py-4">
                            <ConfigDetail onEdit={ openManualEditor } />
                        </div>
                    </div>
                </aside>
            </Show>
        </div>

        <Transition when={ selection.active() } name="g-bulkbar" duration={ 320 }>
            <BulkBar visibleIds={ query.visibleIds } />
        </Transition>

        <ConfigEditor
            open={ () => editorOpenManual }
            initial={ () => editorTarget }
            onClose={ () => editorOpenManual = false }
            onSubmit={ (result) => void submitManual(result) }
        />

        <Sheet open={ () => actionsOpen } onClose={ () => actionsOpen = false } title={ t().servers.actions }>
            <div class="flex flex-col gap-1">
                <Show when={ canTest }>
                    <button type="button" class={ DRAWER_ROW } onClick={ () => { actionsOpen = false; void health.test(query.visibleIds()); } }>
                    { icon(Gauge, 'size-5 shrink-0 text-muted') }
                        <span>{ t().servers.test }</span>
                    </button>
                </Show>

                <Show when={ isTesting }>
                    <button type="button" class={ DRAWER_ROW } onClick={ () => { actionsOpen = false; health.cancel(); } }>
                    { icon(CircleStop, 'size-5 shrink-0 text-poor') }
                        <span class="text-poor">{ t().servers.stop }</span>
                    </button>
                </Show>

                <Show when={ hasServers }>
                    <button type="button" class={ DRAWER_ROW } onClick={ () => { actionsOpen = false; selection.enter(); } }>
                    { icon(ListChecks, 'size-5 shrink-0 text-muted') }
                        <span>{ t().servers.select }</span>
                    </button>
                </Show>

                { /* Sits beside "add a subscription", not inside Import: typing a server
                     is creating one, not importing something that already exists. */ }
                <button type="button" class={ DRAWER_ROW } onClick={ () => { actionsOpen = false; editorTarget = null; editorOpenManual = true; } }>
                { icon(Plus, 'size-5 shrink-0 text-muted') }
                    <span>{ t().editor.addTitle }</span>
                </button>

                <button type="button" class={ DRAWER_ROW } onClick={ () => { actionsOpen = false; openAddSub(); } }>
                { icon(Rss, 'size-5 shrink-0 text-muted') }
                    <span>{ t().subscriptions.add }</span>
                </button>

                <Show when={ hasList }>
                    <button type="button" class={ DRAWER_ROW } onClick={ () => { actionsOpen = false; toggleAll(); } }>
                        <Show when={ allCollapsed() } fallback={ () => icon(ChevronsDownUp, 'size-5 shrink-0 text-muted') }>
                        { icon(ChevronsUpDown, 'size-5 shrink-0 text-muted') }
                        </Show>
                        <span>{ () => allCollapsed() ? t().servers.expandAll : t().servers.collapseAll }</span>
                    </button>
                </Show>
            </div>
        </Sheet>

        <ImportSheet open={ () => importOpen } onClose={ () => importOpen = false } />

        <SubscriptionEditor
            open={ () => editorOpen }
            initial={ () => editing }
            onClose={ () => editorOpen = false }
            onSubmit={ (url, name, intervalMin) => void submitSub(url, name, intervalMin) }
    />

        <DeleteDialog
            sub={ () => deleteTarget }
            onClose={ () => deleteTarget = null }
            onConfirm={ (keepConfigs) => void confirmDelete(keepConfigs) }
    />

        <Show when={ !viewport.isWide() }>
            <Sheet open={ () => detail.openId() !== null } onClose={ () => detail.close() } title={ detail.config()?.name ?? '' }>
                <ConfigDetail onEdit={ openManualEditor } />
            </Sheet>
        </Show>
    </div>
}
