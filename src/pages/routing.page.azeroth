import { For, Show } from 'azerothjs';

import { Check, ChevronDown, ChevronUp, Pencil, Plus, Trash2 } from 'lucide';

import type { Strings } from '../lib/i18n/types';
import { describeRule } from '../lib/routing/describe';
import { BYPASS_COUNTRIES, PRESET_IDS } from '../lib/routing/presets';
import type { CountryMode, ProfileId, Rule, RuleAction } from '../lib/routing/types';

import { useLocale } from '../stores/locale';
import { useRouting } from '../stores/routing';

import { flagIcon } from '../components/flag';
import { icon } from '../components/icon';
import Screen from '../components/screen.component.azeroth';
import Segmented from '../components/segmented.component.azeroth';
import type { SegmentedOption } from '../components/segmented.component.azeroth';

const COUNTRIES: string[] = [...BYPASS_COUNTRIES];

import RuleEditor from '../features/routing/rule-editor.component.azeroth';

const ACTION_TONE: Record<RuleAction, string> =
{
    proxy: 'border-accent/40 bg-accent-soft text-accent',
    direct: 'border-good/40 text-good',
    block: 'border-poor/40 text-poor'
};

const ICON_BTN = 'flex size-8 items-center justify-center rounded-md text-faint hover:bg-elevated hover:text-text';

const presetName = (id: Exclude<ProfileId, 'custom' | 'country'>, s: Strings): string =>
    ({ global: s.routing.presetGlobalName, 'direct-lan': s.routing.presetDirectLanName })[id];

const presetDesc = (id: Exclude<ProfileId, 'custom' | 'country'>, s: Strings): string =>
    ({ global: s.routing.presetGlobalDesc, 'direct-lan': s.routing.presetDirectLanDesc })[id];

/**
 * Routing made legible. A row of mode cards for the common intents, then the
 * active rules rendered as plain sentences - "Iranian sites → Direct" - each with
 * its action colour-coded. Editing anything switches the mode to Custom, because a
 * preset you have changed is no longer that preset.
 */
export default component RoutingPage()
{
    const { t, locale } = useLocale();
    const routing = useRouting();

    // Country names come from the platform, localized for free in every language.
    const regionName = (code: string): string =>
        new Intl.DisplayNames([locale()], { type: 'region' }).of(code.toUpperCase()) ?? code.toUpperCase();

    const countryActive = (code: string): boolean =>
        routing.profileId() === 'country' && routing.country() === code;

    state editorOpen = false;
    state editing = null as Rule | null;
    // Which recipe the country grid builds on the next tap. Local, not persisted -
    // reopening the page always offers a fresh choice rather than reconstructing
    // whatever produced the last-applied profile.
    state countryModeChoice = 'bypass' as CountryMode;

    const countryModeOptions: SegmentedOption[] =
    [
        { value: 'smart', label: () => t().routing.countryModeSmart },
        { value: 'bypass', label: () => t().routing.countryModeBypass }
    ];

    const actionLabel = (action: RuleAction): string =>
        ({ proxy: t().routing.actionProxy, direct: t().routing.actionDirect, block: t().routing.actionBlock })[action];

    const openAdd = (): void =>
    {
        editing = null;
        editorOpen = true;
    };

    const openEdit = (rule: Rule): void =>
    {
        editing = rule;
        editorOpen = true;
    };

    const submit = (type: Rule['type'], value: string, action: RuleAction): void =>
    {
        const current = editing;

        editorOpen = false;

        if (current === null)
        {
            routing.addRule({ type, value, action });
        }
        else
        {
            routing.updateRule(current.id, { type, value, action });
        }
    };

    <div class="h-full">
    <Screen title={ t().routing.title } subtitle={ t().routing.subtitle }>
        <div class="flex flex-col gap-6 px-5 py-6">
            <section class="flex flex-col gap-3">
                <h2 class="text-xs font-semibold text-faint ltr:uppercase ltr:tracking-[0.16em]">{ t().routing.presets }</h2>

                <div class="grid grid-cols-2 gap-2">
                    <For each={ PRESET_IDS } key={ (id) => id }>
                        { (id) =>
                            <button
                                type="button"
                                aria-pressed={ routing.profileId() === id }
                                class={ () => 'flex flex-col gap-1 rounded-2xl border p-3 text-start transition-colors '
                                    + (routing.profileId() === id
                                        ? 'border-accent bg-accent hover:bg-accent-hover'
                                        : 'border-border bg-surface hover:border-border-strong hover:bg-elevated') }
                                onClick={ () => routing.usePreset(id) }
                            >
                                <span class={ () => 'flex items-center gap-1.5 text-sm font-semibold '
                                    + (routing.profileId() === id ? 'text-accent-ink' : 'text-text') }>
                                    { presetName(id, t()) }
                                    <Show when={ routing.profileId() === id }>
                                        { icon(Check, 'size-3.5 shrink-0') }
                                    </Show>
                                </span>
                                <span class={ () => 'text-[11px] leading-snug ' + (routing.profileId() === id ? 'text-accent-ink/80' : 'text-muted') }>
                                    { presetDesc(id, t()) }
                                </span>
                            </button>
                        }
                    </For>
                </div>
            </section>

            <section class="flex flex-col gap-3">
                <div class="flex items-center justify-between gap-3">
                    <h2 class="text-xs font-semibold text-faint ltr:uppercase ltr:tracking-[0.16em]">{ t().routing.bypassCountry }</h2>

                    <div class="w-36 shrink-0">
                        <Segmented
                            label={ t().routing.countryModeLabel }
                            options={ countryModeOptions }
                            value={ countryModeChoice }
                            onSelect={ (value) => countryModeChoice = value as CountryMode }
                        />
                    </div>
                </div>

                <p class="text-[11px] text-faint">
                    { countryModeChoice === 'smart' ? t().routing.countryModeSmartHint : t().routing.bypassCountryHint }
                </p>

                <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-5">
                    <For each={ COUNTRIES } key={ (code) => code }>
                        { (code) =>
                            <button
                                type="button"
                                aria-pressed={ countryActive(code) }
                                class={ () => 'flex items-center gap-2 rounded-xl border px-3 py-2.5 text-start transition-colors '
                                    + (countryActive(code)
                                        ? 'border-accent bg-accent hover:bg-accent-hover'
                                        : 'border-border bg-surface hover:border-border-strong hover:bg-elevated') }
                                onClick={ () => routing.useCountry(code, countryModeChoice) }
                            >
                                <span class={ `${ flagIcon(code) } flag-row shrink-0` }></span>
                                <span class={ () => 'truncate text-sm font-semibold ' + (countryActive(code) ? 'text-accent-ink' : 'text-text') }>
                                    { regionName(code) }
                                </span>
                                <Show when={ countryActive(code) }>
                                    <span class="ms-auto shrink-0 text-accent-ink">{ icon(Check, 'size-4') }</span>
                                </Show>
                            </button>
                        }
                    </For>
                </div>
            </section>

            <section class="flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <h2 class="text-xs font-semibold text-faint ltr:uppercase ltr:tracking-[0.16em]">
                        { t().routing.rulesHeader }
                        <Show when={ routing.profileId() === 'custom' }>
                            <span class="ms-2 rounded-md border border-border px-1.5 py-0.5 text-[10px] normal-case text-muted">
                                { t().routing.presetCustomName }
                            </span>
                        </Show>
                    </h2>

                    <button
                        type="button"
                        class="flex min-h-9 items-center gap-1.5 rounded-lg border border-border px-2.5 text-xs font-medium text-muted hover:bg-elevated"
                        onClick={ () => openAdd() }
                    >
                        { icon(Plus, 'size-3.5') }
                        { t().routing.addRule }
                    </button>
                </div>

                <p class="text-[11px] text-faint">{ t().routing.rulesHint }</p>

                <ol class="flex flex-col gap-2">
                    <For each={ routing.rules() } key={ (rule) => rule.id }>
                        { (rule) =>
                            <li class={ 'flex items-center gap-2 rounded-xl border px-3 py-2.5 '
                                + (describeRule(rule, t()).isFinal ? 'border-dashed border-border-strong bg-transparent' : 'border-border bg-surface') }>
                                <span class="min-w-0 flex-1 truncate text-sm text-text">{ describeRule(rule, t()).subject }</span>

                                <span class={ `shrink-0 rounded-md border px-1.5 py-0.5 text-[11px] font-medium ${ ACTION_TONE[rule.action] ?? '' }` }>
                                    { actionLabel(rule.action) }
                                </span>

                                <Show when={ !describeRule(rule, t()).isFinal }>
                                    <div class="flex shrink-0 items-center">
                                        <button type="button" class={ ICON_BTN } aria-label={ t().routing.moveUp } onClick={ () => routing.move(rule.id, -1) }>
                                            { icon(ChevronUp, 'size-4') }
                                        </button>
                                        <button type="button" class={ ICON_BTN } aria-label={ t().routing.moveDown } onClick={ () => routing.move(rule.id, 1) }>
                                            { icon(ChevronDown, 'size-4') }
                                        </button>
                                        <button type="button" class={ ICON_BTN } aria-label={ t().routing.editRule } onClick={ () => openEdit(rule) }>
                                            { icon(Pencil, 'size-4') }
                                        </button>
                                        <button type="button" class={ ICON_BTN } aria-label={ t().routing.delete } onClick={ () => routing.removeRule(rule.id) }>
                                            { icon(Trash2, 'size-4') }
                                        </button>
                                    </div>
                                </Show>
                            </li>
                        }
                    </For>
                </ol>
            </section>
        </div>
    </Screen>

    <RuleEditor
        open={ () => editorOpen }
        initial={ () => editing }
        onClose={ () => editorOpen = false }
        onSubmit={ (type, value, action) => submit(type, value, action) }
    />
    </div>
}
