import { For, Show } from 'azerothjs';

import { Check, Globe, Info, Languages, ShieldCheck, SwatchBook } from 'lucide';

import Button from '../components/button.component.azeroth';
import Card from '../components/card.component.azeroth';
import { flagIcon } from '../components/flag';
import { icon } from '../components/icon';
import Screen from '../components/screen.component.azeroth';
import SectionHeading from '../components/section-heading.component.azeroth';
import Segmented from '../components/segmented.component.azeroth';
import type { SegmentedOption } from '../components/segmented.component.azeroth';

import { useGeo } from '../stores/geo';
import { LOCALES, LOCALE_COUNTRY, LOCALE_LABELS, useLocale } from '../stores/locale';
import { useTheme } from '../stores/theme';
import type { ThemePreference } from '../stores/theme';
import { useVersion } from '../stores/version';

/**
 * Settings: appearance, language, geo data, and About. Theme and language change every
 * other screen, so they lead; About lets the user see their build and pull a newer one.
 * Every section is an icon-marked heading over a card, so the page reads as one system
 * with the rest of the app rather than a bare form.
 */
export default component SettingsPage()
{
    const { t, locale, setLocale } = useLocale();
    const { preference, setPreference } = useTheme();
    const version = useVersion();
    const geo = useGeo();

    const geoStatusLabel = (present: boolean): string => (present ? t().settings.geoInstalled : t().settings.geoMissing);
    const geoStatusClass = (present: boolean): string =>
        `readout text-sm font-medium ${ present ? 'text-good' : 'text-faint' }`;

    const themeOptions: SegmentedOption[] =
    [
        { value: 'system', label: () => t().settings.themeSystem },
        { value: 'light', label: () => t().settings.themeLight },
        { value: 'dark', label: () => t().settings.themeDark }
    ];

    <Screen title={ t().settings.title } subtitle={ t().settings.subtitle }>
        <div class="flex flex-col gap-8 px-5 py-6">
            <section class="flex flex-col gap-4">
                <SectionHeading glyph={ SwatchBook } label={ t().settings.appearance } />

                <Card class="flex flex-col gap-5 p-4">
                    <div class="flex flex-col gap-2">
                        <p class="text-sm font-medium text-text">{ t().settings.theme }</p>
                        <Segmented
                            label={ t().settings.theme }
                            options={ themeOptions }
                            value={ preference() }
                            onSelect={ (value) => setPreference(value as ThemePreference) }
                        />
                    </div>

                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-2">
                            { icon(Languages, 'size-4 text-muted') }
                            <p class="text-sm font-medium text-text">{ t().settings.language }</p>
                        </div>

                        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                            <For each={ LOCALES } key={ (code) => code } let={ code }>
                                <button
                                    type="button"
                                    aria-pressed={ locale() === code ? 'true' : 'false' }
                                    class={ () => 'flex min-h-11 items-center justify-center gap-2 rounded-xl border px-3 text-sm font-semibold transition-colors '
                                            + (locale() === code
                                                ? 'border-accent bg-accent text-accent-ink hover:bg-accent-hover'
                                                : 'border-border bg-surface text-text hover:border-border-strong hover:bg-elevated') }
                                    onClick={ () => setLocale(code) }
                                >
                                    <span class={ `${ flagIcon(LOCALE_COUNTRY[code]) } flag-row shrink-0` }></span>
                                        { LOCALE_LABELS[code] }
                                    <Show when={ locale() === code }>
                                            { icon(Check, 'size-4 shrink-0') }
                                    </Show>
                                </button>
                            </For>
                        </div>
                    </div>
                </Card>
            </section>

            <section class="flex flex-col gap-4">
                <SectionHeading glyph={ Globe } label={ t().settings.geoFiles } />

                <Card class="flex flex-col gap-3 p-4">
                    <p class="text-sm text-muted">{ t().settings.geoFilesDesc }</p>

                    <div class="flex items-center justify-between">
                        <span class="readout text-sm text-muted">geoip.dat</span>
                        <span class={ geoStatusClass(geo.geoip()) }>{ geoStatusLabel(geo.geoip()) }</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="readout text-sm text-muted">geosite.dat</span>
                        <span class={ geoStatusClass(geo.geosite()) }>{ geoStatusLabel(geo.geosite()) }</span>
                    </div>

                    <Show when={ geo.state() === 'updating' }>
                        <div class="flex flex-col gap-1.5">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted">{ t().settings.updatingGeoFiles }</span>

                                <Show when={ geo.progress() !== null }>
                                    <span class="readout font-medium text-accent" dir="ltr">{ geo.progress() }%</span>
                                </Show>
                            </div>

                            <div class="h-1 w-full overflow-hidden rounded-full bg-border/50">
                                <div
                                    class={ `h-full rounded-full bg-accent transition-[width] duration-300 ${ geo.progress() === null ? 'animate-pulse' : '' }` }
                                    style:width={ `${ geo.progress() ?? 100 }%` }
                                ></div>
                            </div>
                        </div>
                    </Show>

                    <Show when={ geo.state() === 'ready' }>
                        <p class="text-xs text-good">{ t().settings.geoFilesUpdated }</p>
                    </Show>

                    <Show when={ geo.state() === 'error' }>
                        <p class="text-xs text-poor">{ geo.error() }</p>
                    </Show>

                    <div class="flex justify-end">
                        <Button
                            label={ geo.state() === 'updating' ? t().settings.updatingGeoFiles : t().settings.updateGeoFiles }
                            variant="ghost"
                            disabled={ geo.state() === 'updating' }
                            onPress={ () => void geo.update() }
                        />
                    </div>
                </Card>
            </section>

            <section class="flex flex-col gap-4">
                <SectionHeading glyph={ Info } label={ t().settings.about } />

                <Card class="flex flex-col gap-3 p-4">
                    <div class="flex items-center gap-3">
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-border bg-elevated text-accent">
                            { icon(ShieldCheck, 'size-5') }
                        </span>

                        <div class="flex min-w-0 flex-col">
                            <span class="truncate text-sm font-semibold text-text">{ t().app.name }</span>
                            <span class="truncate text-xs text-muted">{ t().app.tagline }</span>
                        </div>

                        <span class="readout ms-auto shrink-0 text-sm font-medium text-text" dir="ltr">{ version.current() }</span>
                    </div>

                    <Show when={ version.state() === 'available' }>
                        <div class="flex flex-col gap-2 rounded-xl border border-accent/40 bg-accent-soft px-3 py-2">
                            <span class="text-sm font-medium text-accent">
                                { t().settings.updateAvailable(version.latest() ?? '') }
                            </span>
                            <div class="flex justify-end">
                                <Button
                                    label={ t().settings.installUpdate }
                                    variant="primary"
                                    onPress={ () => void version.install() }
                                />
                            </div>
                        </div>
                    </Show>

                    <Show when={ version.state() === 'downloading' }>
                        <div class="flex flex-col gap-1.5">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted">{ t().settings.installingUpdate }</span>

                                <Show when={ version.progress() !== null }>
                                    <span class="readout font-medium text-accent" dir="ltr">{ version.progress() }%</span>
                                </Show>
                            </div>

                            <div class="h-1 w-full overflow-hidden rounded-full bg-border/50">
                                <div
                                    class={ `h-full rounded-full bg-accent transition-[width] duration-300 ${ version.progress() === null ? 'animate-pulse' : '' }` }
                                    style:width={ `${ version.progress() ?? 100 }%` }
                                ></div>
                            </div>
                        </div>
                    </Show>

                    <Show when={ version.state() === 'current' }>
                        <p class="text-xs text-good">{ t().settings.upToDate }</p>
                    </Show>

                    <Show when={ version.state() === 'error' }>
                        <p class="text-xs text-poor">{ version.error() }</p>
                    </Show>

                    <Show when={ version.state() !== 'available' && version.state() !== 'downloading' }>
                        <div class="flex justify-end">
                            <Button
                                label={ version.state() === 'checking' ? t().settings.checking : t().settings.checkUpdate }
                                variant="ghost"
                                disabled={ version.state() === 'checking' }
                                onPress={ () => void version.check() }
                            />
                        </div>
                    </Show>
                </Card>
            </section>
        </div>
    </Screen>
}
