import { Match, Show, Switch } from 'azerothjs';

import { Power, Repeat, Wifi, WifiOff, Zap } from 'lucide';

import { humanizeError } from '../lib/health/humanize-error';

import Button from '../components/button.component.azeroth';
import Card from '../components/card.component.azeroth';
import { icon } from '../components/icon';
import SectionHeading from '../components/section-heading.component.azeroth';

import { useConfigs } from '../stores/configs';
import { useConnection } from '../stores/connection';
import { useHealth } from '../stores/health';
import { useLocale } from '../stores/locale';
import { useViewport } from '../stores/viewport';

import CandidateList from '../features/connection/candidate-list.component.azeroth';
import ConnectionStatus from '../features/connection/connection-status.component.azeroth';
import type { ConnectionPhase } from '../features/connection/engine/port';

/** How many switch-server candidates to surface - enough to matter, not a full list. */
const CANDIDATE_LIMIT = 6;

/**
 * The connect screen. Live connection data IS the hero - identity, duration,
 * throughput - not a decorative animation next to it; a status card and an
 * explicit action are simpler and clearer than one giant tap surface. Below it,
 * a ranked "switch server" list means idle is never an empty page: it is the
 * same servers `connectFastest` would pick from, made visible and tappable.
 */
export default component HomePage()
{
    const { t } = useLocale();
    const connection = useConnection();
    const health = useHealth();
    const { rows } = useConfigs();
    const viewport = useViewport();

    const gatePhase = (): ConnectionPhase =>
        connection.switching() ? 'switching' : connection.phase();

    const statusText = (): string =>
    {
        const phase = gatePhase();

        if (phase === 'switching') {return t().home.switching;}
        if (phase === 'connected') {return t().home.connected;}
        if (phase === 'connecting') {return t().home.connecting;}
        if (phase === 'disconnecting') {return t().home.disconnecting;}
        if (phase === 'error') {return t().home.failed;}

        return t().home.disconnected;
    };

    const isBusy = (): boolean => gatePhase() === 'switching' || gatePhase() === 'disconnecting';

    // The same ranking connectFastest uses, made visible: tested servers by score,
    // falling back to favorites (then just the first few) when nothing is tested
    // yet - idle never shows an empty list when servers exist.
    const candidates = (): typeof rowsList =>
    {
        const rowsList = rows();
        const tested = rowsList
            .map((row) => ({ row, s: health.scoreOf(row.id) }))
            .filter((entry) => Number.isFinite(entry.s))
            .sort((a, b) => a.s - b.s)
            .map((entry) => entry.row);

        if (tested.length > 0)
        {
            return tested.slice(0, CANDIDATE_LIMIT);
        }

        const favorites = rowsList.filter((row) => row.favorite);

        return (favorites.length > 0 ? favorites : rowsList).slice(0, CANDIDATE_LIMIT);
    };

    const connectTo = (id: string): void => void connection.connectToId(id);

    <div class="h-full">
        <div class="flex h-full min-h-0 flex-col md:flex-row">
            <section class="flex h-full min-h-0 min-w-0 flex-1 flex-col overflow-y-auto pb-14 md:pb-0">
                <header class="glass-bar shrink-0 border-b border-border">
                    <div class="mx-auto flex w-full max-w-3xl items-center gap-2 px-5 py-4">
                        <span
                            class={ () => `size-2 shrink-0 rounded-full ${
                            gatePhase() === 'connected' ? 'bg-good'
                                : gatePhase() === 'error' ? 'bg-poor'
                                    : isBusy() || gatePhase() === 'connecting' ? 'animate-pulse bg-accent' : 'bg-faint'
                        }` }
                    ></span>
                        <h1 class="text-lg font-semibold tracking-tight text-text">{ statusText() }</h1>
                    </div>
                </header>

                <div class="mx-auto flex w-full max-w-3xl flex-1 flex-col gap-6 px-5 py-6">
                    <Switch>
                        <Match when={ gatePhase() === 'connected' }>
                            <Card class="flex flex-col gap-4 p-4">
                                <ConnectionStatus />
                            </Card>

                            <Button
                                label={ t().home.disconnect }
                                leading={ Power }
                                variant="danger"
                                block={ true }
                                onPress={ () => void connection.disconnect() }
                        />
                        </Match>

                        <Match when={ gatePhase() === 'connecting' || isBusy() }>
                            <Card class="flex flex-col items-center gap-2 p-8 text-center">
                            { icon(Wifi, 'size-8 animate-pulse text-accent') }
                                <p class="text-sm font-medium text-accent">{ statusText() }</p>
                            </Card>

                            <Button
                                label={ statusText() }
                                leading={ Power }
                                variant="primary"
                                block={ true }
                                disabled={ true }
                                onPress={ () => {} }
                        />
                        </Match>

                        <Match when={ gatePhase() === 'error' }>
                            <div class="rounded-2xl border border-poor/40 bg-poor/5 p-4 text-center">
                                <p class="text-sm font-medium text-poor">{ humanizeError(connection.error()).title }</p>
                                <p class="mt-1 text-xs leading-relaxed text-muted">{ humanizeError(connection.error()).fix }</p>
                            </div>

                            <Button
                                label={ t().app.crashRetry }
                                leading={ Power }
                                block={ true }
                                onPress={ () => {
                                const failed = connection.activeConfig();

                                if (failed !== null)
                                {
                                    void connection.connectToId(failed.id);
                                }
                            } }
                        />
                        </Match>

                        <Match when={ true }>
                            <Card class="flex flex-col items-center gap-2 p-8 text-center">
                            { icon(WifiOff, 'size-8 text-faint') }
                                <p class="text-sm font-medium text-muted">{ t().home.disconnected }</p>
                                <p class="text-xs text-faint">{ t().home.noServerSelected }</p>
                            </Card>

                            <Button
                                label={ t().home.connectFastest }
                                leading={ Zap }
                                block={ true }
                                disabled={ rows().length === 0 }
                                onPress={ () => void connection.connectFastest(rows().map((row) => row.id)) }
                        />
                        </Match>
                    </Switch>

                    <Show when={ !viewport.isWide() && candidates().length > 0 }>
                        <section class="flex flex-col gap-3">
                            <SectionHeading glyph={ Repeat } label={ t().home.switchServer } />

                            <CandidateList
                                rows={ candidates() }
                                activeId={ connection.activeId() }
                                onTap={ connectTo }
                            />
                        </section>
                    </Show>
                </div>
            </section>

            <Show when={ viewport.isWide() && candidates().length > 0 }>
                <aside class="flex h-full min-h-0 w-80 shrink-0 flex-col border-s border-border">
                    <div class="glass-bar shrink-0 border-b border-border px-4 py-4">
                        <span class="text-sm font-semibold text-text">{ t().home.switchServer }</span>
                    </div>

                    <div class="min-h-0 flex-1 overflow-y-auto px-4 py-4">
                        <CandidateList
                            rows={ candidates() }
                            activeId={ connection.activeId() }
                            onTap={ connectTo }
                        />
                    </div>
                </aside>
            </Show>
        </div>
    </div>
}
