import { Match, Show, Switch } from 'azerothjs';

import { Power, Zap } from 'lucide';

import { formatBytes } from '../lib/format/bytes';
import { humanizeError } from '../lib/health/humanize-error';

import { useConfigs } from '../stores/configs';
import { useConnection } from '../stores/connection';
import { useLocale } from '../stores/locale';

import Button from '../components/button.component.azeroth';
import Screen from '../components/screen.component.azeroth';

import type { ConnectionPhase } from '../features/connection/engine/port';
import ConnectionGate from '../features/connection/connection-gate.component.azeroth';

/** Seconds to m:ss / h:mm:ss - a live connection duration, tabular so it does not jitter. */
const formatDuration = (seconds: number): string =>
{
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = seconds % 60;
    const pad = (n: number): string => n.toString().padStart(2, '0');

    return h > 0 ? `${ h }:${ pad(m) }:${ pad(s) }` : `${ m }:${ pad(s) }`;
};

const PHASE_TONE: Record<string, string> =
{
    connected: 'text-good',
    connecting: 'text-accent',
    disconnecting: 'text-muted',
    switching: 'text-accent',
    error: 'text-poor',
    idle: 'text-muted'
};

/**
 * The connect screen. The gate is the truth: its state is the engine's state, so
 * "am I actually connected?" is answered by looking at it, not guessed. Below it,
 * the active server and a live duration when connected, or a one-tap "connect
 * fastest" when idle.
 */
export default component HomePage()
{
    const { t } = useLocale();
    const connection = useConnection();

    // During a server-swap we override the phase so the gate, the status text, and
    // the button all show the transitional state together.
    const gatePhase = (): ConnectionPhase =>
        connection.switching() ? 'switching' : connection.phase();

    const statusText = (): string =>
    {
        const phase = gatePhase();

        if (phase === 'switching')
        {
            return t().home.switching;
        }

        if (phase === 'connected')
        {
            return t().home.connected;
        }

        if (phase === 'connecting')
        {
            return t().home.connecting;
        }

        if (phase === 'disconnecting')
        {
            return t().home.disconnecting;
        }

        if (phase === 'error')
        {
            return t().home.failed;
        }

        return t().home.disconnected;
    };

    <Screen title={ t().home.title } subtitle={ t().home.subtitle }>
        <div class="flex flex-col items-center gap-8 px-5 py-10">
            <ConnectionGate phase={ gatePhase } />

            <div class="flex flex-col items-center gap-1 text-center">
                <p class={ `text-xl font-semibold tracking-tight ${ PHASE_TONE[gatePhase()] ?? '' }${ gatePhase() === 'switching' ? ' animate-pulse' : '' }` }>
                    { statusText() }
                </p>

                <Switch>
                    <Match when={ connection.phase() === 'connected' && connection.activeConfig() !== null }>
                        <p class="text-sm font-medium text-text">{ connection.activeConfig()!.name }</p>
                        <p class="readout text-xs text-faint" dir="ltr">
                            { connection.activeConfig()!.host }:{ connection.activeConfig()!.port }
                        </p>
                        <p class="readout mt-1 text-sm text-muted">
                            { t().home.duration(formatDuration(connection.duration())) }
                        </p>
                        <p class="readout text-sm font-medium text-text" dir="ltr">
                            ↑ { formatBytes(connection.traffic().uplink) }   ↓ { formatBytes(connection.traffic().downlink) }
                        </p>
                        <p class="readout text-xs text-faint">
                            { t().home.transferred } <span dir="ltr">{ formatBytes(connection.traffic().uplink + connection.traffic().downlink) }</span>
                        </p>
                    </Match>
                    <Match when={ connection.phase() === 'error' }>
                        <p class="text-sm font-medium text-poor">{ humanizeError(connection.error()).title }</p>
                        <p class="max-w-xs text-xs leading-relaxed text-muted">{ humanizeError(connection.error()).fix }</p>
                    </Match>
                </Switch>
            </div>

            <div class="w-full max-w-xs">
                <Show
                    when={ gatePhase() === 'switching' }
                    fallback={
                        () =>
                            <Show
                                when={ gatePhase() === 'connected' || gatePhase() === 'connecting' }
                                fallback={ () => idleActions() }
                            >
                                <Button
                                    label={ t().home.disconnect }
                                    leading={ Power }
                                    variant="danger"
                                    block={ true }
                                    onPress={ () => void connection.disconnect() }
                                />
                            </Show>
                    }
                >
                    <Button
                        label={ t().home.switching }
                        leading={ Power }
                        variant="primary"
                        block={ true }
                        disabled={ true }
                        onPress={ () => {} }
                    />
                </Show>
            </div>
        </div>
    </Screen>
}

/** The idle-state primary action, built imperatively for the Show fallback. */
const idleActions = (): HTMLElement =>
{
    const { t } = useLocale();
    const { rows } = useConfigs();
    const connection = useConnection();

    const wrap = document.createElement('div');

    wrap.className = 'flex flex-col items-center gap-3';

    const button = Button({
        label: t().home.connectFastest,
        leading: Zap,
        block: true,
        onPress: () => void connection.connectFastest(rows().map((row) => row.id))
    });

    const hint = document.createElement('p');

    hint.className = 'text-center text-xs text-faint';
    hint.textContent = t().home.noServerSelected;

    wrap.append(button, hint);

    return wrap;
};
