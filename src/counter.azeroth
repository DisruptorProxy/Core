import type { IconNode } from 'lucide';

import { invoke } from '@tauri-apps/api/core';

import { createElement, Minus, Plus, RotateCcw } from 'lucide';

interface CounterProps
{
    start?: number;
    step?: number;
}

const icon = (node: IconNode, size: string): HTMLElement => createElement(node, { class: size }) as unknown as HTMLElement;

const createXrayConfig = (): Promise<string> => invoke('create_xray_config', {
    config: {
        "log": {
            "loglevel": "debug"
        },
        inbounds: [
            {
                port: 1080,
                protocol: 'socks',
                settings: { udp: true },
            },
        ],
        outbounds: [
            { protocol: 'freedom' },
        ],
    },
});

export default component Counter(props: CounterProps)
{
    state count = props.start ?? 0;

    derived step = props.step ?? 1;
    derived parity = count % 2 === 0 ? 'even' : 'odd';

    const minusIcon = icon(Minus, 'size-5');
    const plusIcon = icon(Plus, 'size-5');
    const resetIcon = icon(RotateCcw, 'size-4');

    <section class="flex flex-col items-center gap-6 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-sm font-medium uppercase tracking-widest text-slate-500 dark:text-slate-400">Counter</p>

        <output
            class="text-6xl font-semibold tabular-nums text-slate-900 dark:text-slate-50"
            class:text-emerald-600={ count > 0 }
            class:text-rose-600={ count < 0 }
        >
            { count }
        </output>

        <p class="text-xs text-slate-500 dark:text-slate-400">{ parity } &middot; step of { step }</p>

        <div class="flex items-center gap-3">
            <button
                class="flex size-11 items-center justify-center rounded-xl border border-slate-200 text-slate-700 transition hover:bg-slate-100 active:scale-95 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                title="Decrement"
                onClick={ async() => {

                    const result = await invoke('end_xray_windows');

                    console.log('result', result);
                } }
            >
                { minusIcon }
            </button>

            <button
                class="flex items-center gap-1.5 rounded-xl px-3 py-2 text-sm text-slate-500 transition hover:bg-slate-100 disabled:opacity-40 dark:text-slate-400 dark:hover:bg-slate-800"
                title="Reset"
                disabled={ count === (props.start ?? 0) }
                onClick={ () => count = props.start ?? 0 }
            >
                { resetIcon }
                Reset
            </button>

            <button
                class="flex size-11 items-center justify-center rounded-xl bg-slate-900 text-white transition hover:bg-slate-700 active:scale-95 dark:bg-slate-50 dark:text-slate-900 dark:hover:bg-slate-200"
                title="Increment"
                onClick={ async() => {

                    const configPath = await createXrayConfig();

                    const result = await invoke('run_xray_windows', { configPath });

                    console.log('result', result);
                } }
            >
                { plusIcon }
            </button>
        </div>
    </section>
}
