import { For, createEffect, createMemo, createSignal, createVirtualizer, onCleanup } from 'azerothjs';

interface VirtualListProps
{
    /** The ids to display, as a reactive getter. Order is the display order. */
    ids: () => string[];
    /** Fixed row height in CSS pixels. Every row MUST be exactly this tall. */
    rowHeight: number;
    /** Rows rendered above and below the viewport, so a fast scroll shows no gap. */
    overscan?: number;
    /** Builds one row from its id. Called only for rows inside the window. */
    children: (id: string) => HTMLElement;
}

/**
 * A windowed list: renders only the rows in view (plus a small overscan), so 8000
 * ids cost ~25 DOM nodes instead of 8000. The windowing maths live in the
 * framework's createVirtualizer - its equality-guarded range means scrolling
 * WITHIN the current window is a reactive non-event, so rows reconcile only when
 * the window actually moves. This component owns what the framework's packaged
 * <VirtualList> does not offer yet: a ResizeObserver-measured viewport (rotate,
 * window resize, a growing filter bar) and rows in normal flow behind one
 * `translateY`, instead of an explicit fixed height with absolute rows.
 */
export default component VirtualList(props: VirtualListProps)
{
    const [viewport, setViewport] = createSignal(0);

    const virtualizer = createVirtualizer({
        count: () => props.ids().length,
        itemSize: props.rowHeight,
        viewportSize: viewport,
        overscan: props.overscan ?? 6
    });

    const windowIds = createMemo(() =>
    {
        const { start, end } = virtualizer.range();

        return props.ids().slice(start, end + 1);
    });

    const offsetY = (): number => virtualizer.offsetOf(virtualizer.range().start);

    // The scroll element is measured with a ResizeObserver rather than a one-time
    // read: the viewport height changes on rotate, on window resize, and when the
    // filter bar above it grows or shrinks.
    const attach = (element: HTMLElement): void =>
    {
        setViewport(element.clientHeight);

        const observer = new ResizeObserver(() => setViewport(element.clientHeight));

        observer.observe(element);

        createEffect(() => onCleanup(() => observer.disconnect()));
    };

    <div
        ref={ attach }
        class="relative h-full overflow-y-auto overflow-x-hidden overscroll-contain"
        onScroll={ (event) => virtualizer.setScrollOffset((event.target as HTMLElement).scrollTop) }
    >
        <div class="relative w-full" style:height={ `${ virtualizer.totalSize() }px` }>
            <div class="absolute inset-x-0 top-0" style:transform={ `translateY(${ offsetY() }px)` }>
                <For each={ windowIds } key={ (id) => id }>
                    { (id) =>
                        <div style:height={ `${ props.rowHeight }px` }>
                            { props.children(id) }
                        </div>
                    }
                </For>
            </div>
        </div>
    </div>
}
