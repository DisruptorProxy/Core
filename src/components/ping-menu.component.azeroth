import { Show, onCleanup } from 'azerothjs';

import { Activity, ChevronDown, Gauge, Globe, Zap } from 'lucide';

import { icon } from './icon';

import type { PingMode } from '../features/connection/engine/port';

interface PingMenuProps
{
    /** 'icon' = square icon trigger (list header); 'button' = bordered label trigger (detail). */
    variant: 'icon' | 'button';
    /** Accessible name + tooltip for the trigger. */
    label: string;
    /** The two menu item labels. */
    tcpLabel: string;
    proxyLabel: string;
    /** Called with the chosen mode once the menu closes. */
    onPick: (mode: PingMode) => void;
    /** Whole trigger disabled - e.g. a probe is already in flight. */
    disabled?: () => boolean;
    /** The proxy item alone is disabled: the core cannot run this protocol. TCP still works. */
    proxyDisabled?: () => boolean;
    /** 'button' variant only: the trigger's own text, and whether to pulse its icon. */
    text?: () => string;
    busy?: () => boolean;
}

const ITEM = 'flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-start text-sm text-text '
    + 'hover:bg-elevated disabled:pointer-events-none disabled:opacity-40';

/**
 * The ping split-button: one trigger that opens a two-item menu - a raw TCP handshake,
 * or a real round-trip THROUGH the proxy. Both the list header (test all) and the
 * detail sheet (test one) use it, so the choice reads the same everywhere. TCP works
 * for every protocol; the proxy item greys out when the core cannot run this one.
 *
 * The menu is `glass-strong` (opaque enough to read over the content it covers) and
 * dismisses on any outside pointer-down. A `fixed` backdrop is deliberately avoided:
 * this trigger can sit inside a `backdrop-filter` bar, which would trap a fixed child
 * to that bar - a document listener has no such containing-block surprise.
 */
export default component PingMenu(props: PingMenuProps)
{
    state open = false;

    // The active outside-click listener's remover, so closing (by any path - a pick,
    // the trigger, an outside click) always tears it down exactly once.
    let removeOutside: (() => void) | null = null;
    // The pending arm-the-listener timer, so an unmount between opening and arming
    // cannot leave it to fire against a component that is already gone.
    let armTimer = 0;

    const close = (): void =>
    {
        open = false;
        window.clearTimeout(armTimer);
        armTimer = 0;
        removeOutside?.();
        removeOutside = null;
    };

    const openMenu = (): void =>
    {
        open = true;

        const onDown = (event: Event): void =>
        {
            if ((event.target as HTMLElement | null)?.closest('[data-ping-menu]') === null)
            {
                close();
            }
        };

        // A tick later, so the very click that opened the menu is not the one that
        // closes it; skip if a fast pick already closed it in the meantime.
        armTimer = window.setTimeout(() =>
        {
            armTimer = 0;

            if (!open)
            {
                return;
            }

            document.addEventListener('pointerdown', onDown, true);
            removeOutside = (): void => document.removeEventListener('pointerdown', onDown, true);
        }, 0);
    };

    // Unmounting while open never runs `close()` on its own, which would strand the
    // capturing document listener (and any pending arm timer) for the life of the app.
    onCleanup(close);

    const pick = (mode: PingMode): void =>
    {
        close();
        props.onPick(mode);
    };

    const triggerClass = (): string =>
        props.variant === 'icon'
            ? 'flex size-11 items-center justify-center rounded-lg border border-border text-muted hover:bg-elevated press disabled:opacity-40'
            : 'flex min-h-8 items-center gap-1.5 rounded-lg border border-border px-2.5 text-xs font-medium text-muted hover:bg-elevated disabled:opacity-40';

    const glyph = (): HTMLElement =>
        props.variant === 'icon'
            ? icon(Gauge, 'size-4')
            : icon(Activity, props.busy?.() === true ? 'size-3.5 animate-pulse' : 'size-3.5');

    <div class="relative" data-ping-menu>
        <button
            type="button"
            class={ triggerClass() }
            aria-label={ props.label }
            data-tip={ props.label }
            aria-haspopup="menu"
            aria-expanded={ open ? 'true' : 'false' }
            disabled={ props.disabled?.() === true }
            onClick={ () => open ? close() : openMenu() }
        >
            { glyph() }

            <Show when={ props.variant === 'button' }>
                <span class="flex items-center gap-1.5">
                    <span>{ () => props.text?.() ?? '' }</span>
                    { icon(ChevronDown, 'size-3.5 opacity-70') }
                </span>
            </Show>
        </button>

        <Show when={ open }>
            <div
                class="absolute end-0 top-full z-50 mt-1 min-w-44 rounded-xl glass-strong p-1"
                role="menu"
            >
                <button type="button" role="menuitem" class={ ITEM } onClick={ () => pick('tcp') }>
                    { icon(Zap, 'size-4 text-muted') }
                    { props.tcpLabel }
                </button>

                <button
                    type="button"
                    role="menuitem"
                    class={ ITEM }
                    disabled={ props.proxyDisabled?.() === true }
                    onClick={ () => pick('proxy') }
                >
                    { icon(Globe, 'size-4 text-muted') }
                    { props.proxyLabel }
                </button>
            </div>
        </Show>
    </div>
}
