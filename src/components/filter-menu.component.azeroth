import { For, Show } from 'azerothjs';

import { Check, ChevronDown, Search } from 'lucide';

import { icon } from './icon';
import Sheet from './sheet.component.azeroth';

export interface FilterOption
{
    value: string;
    label: string;
}

interface FilterMenuProps
{
    /** The facet name, shown muted on the trigger, e.g. "Source". */
    label: string;
    /** The current selection, shown bold on the trigger, e.g. a subscription name. */
    summary: () => string;
    /** Whether a non-default filter is set - highlights the trigger. */
    active: () => boolean;
    options: () => FilterOption[];
    selected: (value: string) => boolean;
    onSelect: (value: string) => void;
    /** Multi-select keeps the sheet open so several values can be toggled. */
    multi?: boolean;
    searchable?: boolean;
    searchPlaceholder?: string;
}

/**
 * A filter as a dropdown, not a chip rail. A chip per option collapses once a list
 * grows - 100 subscriptions become an unusable horizontal scroll. This shows one
 * compact trigger with the current choice, and opens a searchable, scrollable sheet
 * of options. It scales from three protocols to a hundred sources without changing.
 */
export default component FilterMenu(props: FilterMenuProps)
{
    state open = false;
    state term = '';

    const filtered = (): FilterOption[] =>
    {
        const needle = term.trim().toLowerCase();

        if (needle === '')
        {
            return props.options();
        }

        return props.options().filter((option) => option.label.toLowerCase().includes(needle));
    };

    const close = (): void =>
    {
        open = false;
        term = '';
    };

    const choose = (value: string): void =>
    {
        props.onSelect(value);

        if (!props.multi)
        {
            close();
        }
    };

    <div class="contents">
        <button
            type="button"
            class={ 'flex shrink-0 items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium transition-colors '
                + (props.active()
                    ? 'border-accent bg-accent-soft text-accent'
                    : 'border-border text-muted hover:bg-elevated') }
            onClick={ () => open = true }
        >
            <span class={ props.active() ? 'text-accent/70' : 'text-faint' }>{ props.label }</span>
            <span class="max-w-32 truncate">{ props.summary() }</span>
            { icon(ChevronDown, 'size-3.5 opacity-70') }
        </button>

        <Sheet open={ () => open } onClose={ close } title={ props.label }>
            <div class="flex flex-col gap-3">
                <Show when={ props.searchable }>
                    <label class="glass flex items-center gap-2 rounded-xl px-3">
                        { icon(Search, 'size-4 text-faint') }

                        <input
                            type="search"
                            class="min-h-11 w-full bg-transparent text-sm text-text outline-none placeholder:text-faint"
                            placeholder={ props.searchPlaceholder ?? '' }
                            bind:value={ term }
                        />
                    </label>
                </Show>

                <div class="-mx-2 max-h-[52vh] overflow-y-auto">
                    <For each={ filtered() } key={ (option) => option.value }>
                        { (option) =>
                            <button
                                type="button"
                                class="flex w-full items-center justify-between gap-3 rounded-xl px-2 py-2.5 text-start text-sm hover:bg-elevated"
                                onClick={ () => choose(option.value) }
                            >
                                <span class={ props.selected(option.value) ? 'truncate font-medium text-accent' : 'truncate text-text' }>
                                    { option.label }
                                </span>

                                <Show when={ props.selected(option.value) }>
                                    { icon(Check, 'size-4 shrink-0 text-accent') }
                                </Show>
                            </button>
                        }
                    </For>
                </div>
            </div>
        </Sheet>
    </div>
}
