import { For, styleMap } from 'azerothjs';

export interface SegmentedOption
{
    value: string;
    /**
     * A getter, not a string. `<For>` reuses a row whose key has not changed, so a
     * label baked in at row-creation time would go stale the moment the locale
     * changes - the row's DOM survives, holding the old text. Reading through a
     * getter makes the label its own reactive binding, which updates in place.
     *
     * The same rule governs every list in this app, including the 8000-row server
     * list: a row must READ its live values, never capture a snapshot of them.
     */
    label: () => string;
}

interface SegmentedProps
{
    /** Accessible name for the group - it has no visible label of its own. */
    label: string;
    options: SegmentedOption[];
    value: string;
    onSelect: (value: string) => void;
}

const OPTION = 'relative z-10 min-h-9 flex-1 rounded-lg px-3 text-sm font-medium press';

/**
 * A radio group that looks like a switch. Radio semantics (not tabs) because it
 * sets a value; screen readers then announce it as a choice, not navigation.
 *
 * A single pill (`.g-seg-thumb`) slides to the selected option instead of each
 * button toggling its own background: `--seg-count`/`--seg-index` are set inline
 * here and the thumb's CSS reads them, so the slide is one composited transform
 * and stays correct under RTL.
 */
export default component Segmented(props: SegmentedProps)
{
    <div
        class="relative flex rounded-xl border border-border bg-surface p-1"
        role="radiogroup"
        aria-label={ props.label }
        style={ styleMap({
            '--seg-count': () => props.options.length,
            '--seg-index': () => props.options.findIndex((option) => option.value === props.value)
        }) }
    >
        <div class="g-seg-thumb" aria-hidden="true"></div>

        <For each={ props.options } key={ (option) => option.value }>
            { (option) =>
                <button
                    type="button"
                    role="radio"
                    aria-checked={ props.value === option.value ? 'true' : 'false' }
                    class={ `${ OPTION } ${ props.value === option.value
                        ? 'text-accent-ink'
                        : 'text-muted hover:text-text' }` }
                    onClick={ () => props.onSelect(option.value) }
                >
                    { option.label() }
                </button>
            }
        </For>
    </div>
}
