import { For, Show, onCleanup } from 'azerothjs';

import { Check, Search } from 'lucide';

import { icon } from './icon';

export interface FilterOption
{
    value: string;
    label: string;
}

interface FilterOptionsProps
{
    /** Id root for the listbox and its options, so aria-activedescendant resolves. */
    id: string;
    options: () => FilterOption[];
    selected: (value: string) => boolean;
    /** Chosen by click or by Enter/Space. The parent decides whether to close. */
    onChoose: (value: string) => void;
    /** Escape, or a choice that should dismiss. Returns focus to the trigger. */
    onDismiss: () => void;
    multi?: boolean;
    searchable?: boolean;
    searchPlaceholder?: string;
}

/**
 * Row height in CSS pixels. The windowing maths below is exact rather than measured,
 * so every option MUST be this tall - `h-10` on the row enforces it.
 */
const ROW = 40;

/** Rows kept above and below the viewport so a fast scroll never shows a gap. */
const OVERSCAN = 6;

/** Fallback viewport height, replaced with the real one the moment the list mounts. */
const FALLBACK_VIEW = 288;

const OPTION = 'flex h-10 w-full items-center justify-between gap-3 rounded-lg px-2 text-start text-sm';

/** How long a type-ahead run stays open before the next keystroke starts a fresh one. */
const TYPEAHEAD_MS = 600;

/**
 * The option list behind every filter control - the same listbox whether it is shown
 * in a desktop popover or a touch bottom sheet, so the keyboard model and the
 * semantics are written once.
 *
 * WINDOWED, for the same reason the server list is: a user with a thousand
 * subscriptions would otherwise mount a thousand option nodes (40,000px of scroll
 * height) to show the seven that fit, and pay ~120ms every time the menu opens. The
 * windowing is inlined rather than delegated to `VirtualList` because this list needs
 * two things that component does not offer: JSX rows (so `selected` and the active
 * highlight stay reactive, instead of an imperative builder frozen at mount) and
 * external control of `scrollTop`, without which keyboard navigation cannot follow the
 * active option once it leaves the rendered window. A short list windows to itself, so
 * there is only one code path.
 *
 * Keyboard: Up/Down move, Home/End jump, Enter/Space choose, Escape dismisses, and
 * printable characters type-ahead by label. Focus stays on ONE element (the search
 * field, or the list itself) and the active option is published through
 * `aria-activedescendant` - which is what keeps a screen reader on script while the
 * DOM underneath it is being recycled.
 */
export default component FilterOptions(props: FilterOptionsProps)
{
    state term = '';
    state active = 0;
    state scrollTop = 0;
    state viewHeight = FALLBACK_VIEW;

    let listEl: HTMLElement | null = null;
    let typeahead = '';
    let typeaheadTimer = 0;

    onCleanup(() => window.clearTimeout(typeaheadTimer));

    const filtered = (): FilterOption[] =>
    {
        const needle = term.trim().toLowerCase();

        if (needle === '')
        {
            return props.options();
        }

        return props.options().filter((option) => option.label.toLowerCase().includes(needle));
    };

    /** The slice of options currently worth having in the DOM. */
    const first = (): number => Math.max(0, Math.floor(scrollTop / ROW) - OVERSCAN);

    const visible = (): FilterOption[] =>
    {
        const start = first();
        const count = Math.ceil(viewHeight / ROW) + OVERSCAN * 2;

        return filtered().slice(start, start + count);
    };

    /**
     * Scrolls the active option into view by INDEX, not by element: once the list is
     * windowed the active row may not be mounted, and `scrollIntoView` on a missing
     * node silently does nothing - which would look like the arrow keys had frozen.
     */
    const revealActive = (): void =>
    {
        if (listEl === null)
        {
            return;
        }

        const top = active * ROW;

        if (top < listEl.scrollTop)
        {
            listEl.scrollTop = top;
        }
        else if (top + ROW > listEl.scrollTop + listEl.clientHeight)
        {
            listEl.scrollTop = top + ROW - listEl.clientHeight;
        }
    };

    const move = (delta: number): void =>
    {
        const total = filtered().length;

        if (total === 0)
        {
            return;
        }

        // Wraps, the way a native menu does - Down on the last row returns to the first.
        active = (active + delta + total) % total;
        revealActive();
    };

    const jump = (index: number): void =>
    {
        active = index;
        revealActive();
    };

    const chooseActive = (): void =>
    {
        const option = filtered()[active];

        if (option !== undefined)
        {
            props.onChoose(option.value);
        }
    };

    /** Jump to the first label starting with the run of characters typed so far. */
    const runTypeahead = (char: string): void =>
    {
        window.clearTimeout(typeaheadTimer);

        typeahead += char.toLowerCase();
        typeaheadTimer = window.setTimeout(() => typeahead = '', TYPEAHEAD_MS);

        const index = filtered().findIndex((option) => option.label.toLowerCase().startsWith(typeahead));

        if (index !== -1)
        {
            jump(index);
        }
    };

    const onKeyDown = (event: KeyboardEvent): void =>
    {
        if (event.key === 'ArrowDown')
        {
            event.preventDefault();
            move(1);
        }
        else if (event.key === 'ArrowUp')
        {
            event.preventDefault();
            move(-1);
        }
        else if (event.key === 'Home')
        {
            event.preventDefault();
            jump(0);
        }
        else if (event.key === 'End')
        {
            event.preventDefault();
            jump(Math.max(0, filtered().length - 1));
        }
        else if (event.key === 'Enter' || event.key === ' ')
        {
            // Space types a space into the search field; it only chooses without one.
            if (event.key === ' ' && props.searchable === true)
            {
                return;
            }

            event.preventDefault();
            chooseActive();
        }
        else if (event.key === 'Escape')
        {
            event.preventDefault();
            props.onDismiss();
        }
        else if (props.searchable !== true && event.key.length === 1 && !event.ctrlKey && !event.metaKey)
        {
            // Type-ahead is the search affordance for a list with no search field.
            event.preventDefault();
            runTypeahead(event.key);
        }
    };

    const attach = (element: HTMLElement): void =>
    {
        listEl = element;
        viewHeight = element.clientHeight > 0 ? element.clientHeight : FALLBACK_VIEW;

        // Open ON the current selection rather than at the top: a hundred sources with
        // the active one scrolled out of sight is what makes a long menu feel broken.
        const index = props.options().findIndex((option) => props.selected(option.value));

        if (index > 0)
        {
            active = index;
        }

        // Deferred a frame so the list has laid out and can actually be scrolled.
        requestAnimationFrame(() =>
        {
            viewHeight = element.clientHeight > 0 ? element.clientHeight : FALLBACK_VIEW;
            revealActive();
        });
    };

    <div class="flex flex-col gap-2" onKeyDown={ onKeyDown }>
        <Show when={ props.searchable }>
            <label class="glass flex items-center gap-2 rounded-xl px-3">
                { icon(Search, 'size-4 text-faint') }

                <input
                    type="search"
                    class="min-h-11 w-full bg-transparent text-sm text-text outline-none placeholder:text-faint"
                    placeholder={ props.searchPlaceholder ?? '' }
                    role="combobox"
                    aria-expanded="true"
                    aria-controls={ `${ props.id }-list` }
                    aria-activedescendant={ `${ props.id }-opt-${ active }` }
                    autofocus
                    bind:value={ term }
                    onInput={ () =>
                    {
                        // A new query renames every row, so the old active index is
                        // meaningless - go back to the top of the new results.
                        active = 0;

                        if (listEl !== null)
                        {
                            listEl.scrollTop = 0;
                        }

                        scrollTop = 0;
                    } }
                />
            </label>
        </Show>

        <div
            ref={ attach }
            id={ `${ props.id }-list` }
            class="-mx-1 max-h-[52vh] overflow-y-auto outline-none sm:max-h-72"
            role="listbox"
            aria-multiselectable={ props.multi === true ? 'true' : 'false' }
            aria-activedescendant={ `${ props.id }-opt-${ active }` }
            tabindex={ props.searchable === true ? -1 : 0 }
            onScroll={ (event) => scrollTop = (event.target as HTMLElement).scrollTop }
        >
            <div class="relative" style:height={ `${ filtered().length * ROW }px` }>
                <div class="absolute inset-x-0 top-0" style:transform={ `translateY(${ first() * ROW }px)` }>
                    <For each={ visible() } key={ (option) => option.value }>
                        { (option, index) =>
                            <div
                                id={ `${ props.id }-opt-${ first() + index() }` }
                                class={ `${ OPTION } ${ first() + index() === active ? 'bg-elevated' : '' }` }
                                role="option"
                                aria-selected={ props.selected(option.value) ? 'true' : 'false' }
                                onClick={ () => props.onChoose(option.value) }
                                onPointerMove={ () => active = first() + index() }
                            >
                                <span class={ props.selected(option.value) ? 'truncate font-medium text-accent' : 'truncate text-text' }>
                                    { option.label }
                                </span>

                                <Show when={ props.selected(option.value) }>
                                    { icon(Check, 'size-4 shrink-0 text-accent') }
                                </Show>
                            </div>
                        }
                    </For>
                </div>
            </div>
        </div>
    </div>
}
